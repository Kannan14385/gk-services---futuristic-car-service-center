      name: "create_file"
      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { X, CheckCircle, AlertTriangle, Cpu, Wrench, Shield, ArrowRight, Layers, Sparkles } from \'lucide-react\';\\nimport { CarHotspot } from \'../types\';\\n\\ninterface BeforeAfterModalProps {\\n  hotspot: CarHotspot | null;\\n  onClose: () => void;\\n  onBookService: (serviceName: string) => void;\\n}\\n\\nexport const BeforeAfterModal: React.FC<BeforeAfterModalProps> = ({\\n  hotspot,\\n  onClose,\\n  onBookService,\\n}) => {\\n  const [sliderPosition, setSliderPosition] = useState<number>(50);\\n  const [isDragging, setIsDragging] = useState<boolean>(false);\\n  const [viewMode, setViewMode] = useState<\'interactive\' | \'side-by-side\'>(\'interactive\');\\n\\n  if (!hotspot) return null;\\n\\n  const handleSliderMove = (clientX: number, rect: DOMRect) => {\\n    const x = clientX - rect.left;\\n    const pos = Math.max(0, Math.min(100, (x / rect.width) * 100));\\n    setSliderPosition(pos);\\n  };\\n\\n  const handleMouseMove = (e: React.MouseEvent<HTMLDivElement>) => {\\n    if (!isDragging) return;\\n    const rect = e.currentTarget.getBoundingClientRect();\\n    handleSliderMove(e.clientX, rect);\\n  };\\n\\n  const handleTouchMove = (e: React.TouchEvent<HTMLDivElement>) => {\\n    const rect = e.currentTarget.getBoundingClientRect();\\n    if (e.touches[0]) {\\n      handleSliderMove(e.touches[0].clientX, rect);\\n    }\\n  };\\n\\n  return (\\n    <div\\n      id=\\\"before-after-modal-backdrop\\\"\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 bg-black/85 backdrop-blur-xl animate-fadeIn\\\"\\n      onClick={(e) => {\\n        if (e.target === e.currentTarget) onClose();\\n      }}\\n    >\\n      <div\\n        id=\\\"before-after-modal-container\\\"\\n        className=\\\"relative w-full max-w-4xl max-h-[92vh] overflow-y-auto bg-[#0a0e17] border border-[#00f0ff]/50 rounded-2xl shadow-[0_0_50px_rgba(0,240,255,0.25)] flex flex-col\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        {/* Futuristic Modal Header */}\\n        <div className=\\\"relative px-5 py-4 border-b border-[#00f0ff]/20 flex items-center justify-between bg-gradient-to-r from-[#0d1322] via-[#0a0e17] to-[#0d1322]\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"p-2 rounded-lg bg-[#00f0ff]/10 border border-[#00f0ff]/30 text-[#00f0ff]\\\">\\n              <Sparkles className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <span className=\\\"text-[10px] font-mono-tech uppercase tracking-widest text-[#00f0ff] bg-[#00f0ff]/10 px-2 py-0.5 rounded border border-[#00f0ff]/30\\\">\\n                  {hotspot.category}\\n                </span>\\n                <span className=\\\"text-[10px] font-mono-tech text-[#94a3b8]\\\">\\n                  TARGET: {hotspot.part}\\n                </span>\\n              </div>\\n              <h2 className=\\\"font-orbitron font-bold text-lg sm:text-xl text-white mt-0.5\\\">\\n                {hotspot.name}\\n              </h2>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-3\\\">\\n            {/* View Mode Toggle */}\\n            <div className=\\\"hidden sm:flex items-center bg-[#07090e] p-0.5 rounded-lg border border-[#00f0ff]/20\\\">\\n              <button\\n                onClick={() => setViewMode(\'interactive\')}\\n                className={`px-2.5 py-1 text-xs font-mono-tech rounded ${\\n                  viewMode === \'interactive\' ? \'bg-[#00f0ff] text-[#07090e] font-semibold\' : \'text-[#94a3b8]\'\\n                }`}\\n              >\\n                Reveal Slider\\n              </button>\\n              <button\\n                onClick={() => setViewMode(\'side-by-side\')}\\n                className={`px-2.5 py-1 text-xs font-mono-tech rounded ${\\n                  viewMode === \'side-by-side\' ? \'bg-[#00f0ff] text-[#07090e] font-semibold\' : \'text-[#94a3b8]\'\\n                }`}\\n              >\\n                Split View\\n              </button>\\n            </div>\\n\\n            <button\\n              id=\\\"close-before-after-modal\\\"\\n              onClick={onClose}\\n              className=\\\"p-2 text-[#94a3b8] hover:text-[#00f0ff] hover:bg-[#00f0ff]/10 rounded-lg transition-colors\\\"\\n              aria-label=\\\"Close modal\\\"\\n            >\\n              <X className=\\\"w-6 h-6\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Modal Body */}\\n        <div className=\\\"p-5 sm:p-6 space-y-6\\\">\\n          {/* Comparison Viewport */}\\n          {viewMode === \'interactive\' ? (\\n            <div className=\\\"relative rounded-xl overflow-hidden border border-[#00f0ff]/30 bg-[#07090e] select-none\\\">\\n              <div\\n                className=\\\"relative h-64 sm:h-80 md:h-96 w-full cursor-ew-resize overflow-hidden\\\"\\n                onMouseDown={() => setIsDragging(true)}\\n                onMouseUp={() => setIsDragging(false)}\\n                onMouseLeave={() => setIsDragging(false)}\\n                onMouseMove={handleMouseMove}\\n                onTouchMove={handleTouchMove}\\n                onClick={(e) => {\\n                  const rect = e.currentTarget.getBoundingClientRect();\\n                  handleSliderMove(e.clientX, rect);\\n                }}\\n              >\\n                {/* AFTER IMAGE (Base Layer) */}\\n                <div className=\\\"absolute inset-0 w-full h-full\\\">\\n                  <img\\n                    src={hotspot.after.image}\\n                    alt={`${hotspot.name} After Restoration`}\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"w-full h-full object-cover\\\"\\n                  />\\n                  <div className=\\\"absolute bottom-4 right-4 z-10 bg-emerald-950/80 backdrop-blur-md border border-emerald-500/50 text-emerald-300 px-3 py-1.5 rounded-lg text-xs font-mono-tech flex items-center gap-1.5 shadow-lg\\\">\\n                    <CheckCircle className=\\\"w-3.5 h-3.5 text-emerald-400\\\" />\\n                    <span>AFTER ENHANCEMENT ({hotspot.after.conditionScore}%)</span>\\n                  </div>\\n                </div>\\n\\n                {/* BEFORE IMAGE (Clipped Layer) */}\\n                <div\\n                  className=\\\"absolute inset-0 w-full h-full overflow-hidden transition-none\\\"\\n                  style={{ width: `${sliderPosition}%` }}\\n                >\\n                  <img\\n                    src={hotspot.before.image}\\n                    alt={`${hotspot.name} Before Service`}\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"absolute inset-0 w-full h-full object-cover max-w-none\\\"\\n                    style={{ width: \'100%\', minWidth: \'100%\' }}\\n                  />\\n                  <div className=\\\"absolute bottom-4 left-4 z-10 bg-rose-950/80 backdrop-blur-md border border-rose-500/50 text-rose-300 px-3 py-1.5 rounded-lg text-xs font-mono-tech flex items-center gap-1.5 shadow-lg\\\">\\n                    <AlertTriangle className=\\\"w-3.5 h-3.5 text-rose-400\\\" />\\n                    <span>BEFORE SERVICE ({hotspot.before.conditionScore}%)</span>\\n                  </div>\\n                </div>\\n\\n                {/* Drag Handle Divider */}\\n                <div\\n                  className=\\\"absolute top-0 bottom-0 w-1 bg-[#00f0ff] cursor-ew-resize shadow-[0_0_15px_#00f0ff]\\\"\\n                  style={{ left: `${sliderPosition}%` }}\\n                >\\n                  <div className=\\\"absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-[#07090e] border-2 border-[#00f0ff] flex items-center justify-center shadow-[0_0_20px_#00f0ff]\\\">\\n                    <div className=\\\"flex gap-0.5\\\">\\n                      <div className=\\\"w-0.5 h-3 bg-[#00f0ff]\\\" />\\n                      <div className=\\\"w-0.5 h-3 bg-[#00f0ff]\\\" />\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Interaction Hint */}\\n              <div className=\\\"py-2 px-4 bg-[#0d1322] border-t border-[#00f0ff]/20 flex items-center justify-between text-[11px] font-mono-tech text-[#94a3b8]\\\">\\n                <span>\342\227\200 DRAG SLIDER TO REVEAL BEFORE / AFTER \342\226\266</span>\\n                <span className=\\\"text-[#00f0ff] font-semibold\\\">{sliderPosition.toFixed(0)}% REVEALED</span>\\n              </div>\\n            </div>\\n          ) : (\\n            /* Side-by-Side View */\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n              <div className=\\\"rounded-xl overflow-hidden border border-rose-500/40 bg-[#0d1322] flex flex-col\\\">\\n                <div className=\\\"relative h-48 sm:h-60\\\">\\n                  <img\\n                    src={hotspot.before.image}\\n                    alt=\\\"Before Service\\\"\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"w-full h-full object-cover\\\"\\n                  />\\n                  <div className=\\\"absolute top-3 left-3 bg-rose-950/90 border border-rose-500 text-rose-300 px-2.5 py-1 rounded text-xs font-mono-tech\\\">\\n                    BEFORE SERVICE \302\267 {hotspot.before.conditionScore}%\\n                  </div>\\n                </div>\\n                <div className=\\\"p-4 flex-1\\\">\\n                  <h4 className=\\\"font-orbitron text-sm font-semibold text-rose-400 mb-2\\\">\\n                    {hotspot.before.status}\\n                  </h4>\\n                  <ul className=\\\"space-y-1.5 text-xs text-[#94a3b8]\\\">\\n                    {hotspot.before.issues.map((issue, idx) 