        }
        lines {
          text: "      // Auto rotation"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (isAutoRotating) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        orbitState.current.targetTheta += 0.008;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
