    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { Menu, X, Shield, Radio, Sparkles, Code2, Download, Sun, Moon } from \'lucide-react\';\n\ninterface HeaderProps {\n  theme: \'dark\' | \'light\';\n  onToggleTheme: () => void;\n  onOpenContact: () => void;\n  onOpenCodeZip: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ theme, onToggleTheme, onOpenContact, onOpenCodeZip }) => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [activeSection, setActiveSection] = useState(\'hero\');\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 20);\n\n      const sections = [\'hero\', \'inspection360\', \'services\', \'technology\', \'calculator\', \'reviews\'];\n      const scrollPos = window.scrollY + 200;\n\n      for (const section of sections) {\n        const el = document.getElementById(section);\n        if (el) {\n          const top = el.offsetTop;\n          const height = el.offsetHeight;\n          if (scrollPos >= top && scrollPos < top + height) {\n            setActiveSection(section);\n            break;\n          }\n        }\n      }\n    };\n\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { label: \'Mission Hub\', href: \'#hero\', id: \'hero\' },\n    { label: \'360\302\260 Car Scan\', href: \'#inspection360\', id: \'inspection360\', badge: \'Multi-Axis\' },\n    { label: \'Services Matrix\', href: \'#services\', id: \'services\' },\n    { label: \'Robotic Bays\', href: \'#technology\', id: \'technology\' },\n    { label: \'Cost Terminal\', href: \'#calculator\', id: \'calculator\' },\n    { label: \'Reviews & FAQ\', href: \'#reviews\', id: \'reviews\' },\n  ];\n\n  const handleNavClick = (href: string) => {\n    setMobileMenuOpen(false);\n    const element = document.querySelector(href);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      id=\"main-header\"\n      className={`sticky top-0 z-50 w-full transition-all duration-300 ${\n        isScrolled\n          ? \'bg-[var(--bg-card)]/90 backdrop-blur-xl border-b border-[var(--border-color)] shadow-[0_10px_30px_rgba(0,0,0,0.3)]\'\n          : \'bg-gradient-to-b from-[var(--bg-primary)] via-[var(--bg-primary)]/85 to-transparent border-b border-transparent\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n        {/* Division 1: Logo Gk */}\n        <div id=\"header-logo-division\" className=\"flex items-center gap-3\">\n          <a\n            href=\"#hero\"\n            onClick={(e) => {\n              e.preventDefault();\n              handleNavClick(\'#hero\');\n            }}\n            className=\"group flex items-center gap-3 cursor-pointer\"\n          >\n            {/* Futuristic GK Hex Icon */}\n            <div className=\"relative w-11 h-11 flex items-center justify-center bg-[var(--bg-card)] border border-[var(--accent-cyan)]/50 rounded-lg overflow-hidden group-hover:border-[var(--accent-cyan)] group-hover:shadow-[0_0_20px_var(--accent-glow)] transition-all duration-300\">\n              <div className=\"absolute inset-0 bg-gradient-to-br from-[var(--accent-cyan)]/20 to-transparent opacity-60 group-hover:opacity-100 transition-opacity\" />\n              <span className=\"font-primary font-black text-xl tracking-tighter text-[var(--accent-cyan)] group-hover:scale-110 transition-transform\">\n                GK\n              </span>\n              <div className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-[var(--accent-cyan)]\" />\n            </div>\n\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"font-primary font-extrabold text-lg sm:text-xl tracking-wider text-[var(--text-primary)]\">\n                  GK <span className=\"text-[var(--accent-cyan)]\">SERVICES</span>\n                </span>\n                <span className=\"hidden sm:inline-block px-1.5 py-0.5 text-[9px] font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--accent-cyan)] border border-[var(--border-color)] rounded\">\n                  v3.4.0\n                </span>\n              </div>\n              <span className=\"text-[10px] font-mono-tech tracking-widest text-[var(--text-secondary)] uppercase\">\n                Autonomous Precision Center\n              </span>\n            </div>\n          </a>\n        </div>\n\n        {/* Division 2: Navigation Menu (Desktop view > 1024px) */}\n        <nav\n          id=\"header-nav-division\"\n          className=\"hidden lg:flex items-center gap-1 xl:gap-2 px-3 py-1.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-full backdrop-blur-md shadow-sm\"\n        >\n          {navLinks.map((link) => {\n            const isActive = activeSection === link.id;\n            return (\n              <a\n                key={link.id}\n                id={`nav-link-${link.id}`}\n                href={link.href}\n                onClick={(e) => {\n                  e.preventDefault();\n                  handleNavClick(link.href);\n                }}\n                className={`relative px-3 py-1.5 rounded-full text-xs xl:text-sm font-medium transition-all duration-300 flex items-center gap-1.5 ${\n                  isActive\n                    ? \'text-white bg-[var(--accent-cyan)] font-semibold shadow-[0_0_15px_var(--accent-glow)]\'\n                    : \'text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10\'\n                }`}\n              >\n                <span>{link.label}</span>\n                {link.badge && !isActive && (\n                  <span className=\"relative flex h-2 w-2\">\n                    <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent-cyan)] opacity-75\"></span>\n                    <span className=\"relative inline-flex rounded-full h-2 w-2 bg-[var(--accent-cyan)]\"></span>\n                  </span>\n                )}\n              </a>\n            );\n          })}\n        </nav>\n\n        {/* Division 3: Actions + Mobile/Tablet Hamburger Toggle */}\n        <div id=\"header-contact-division\" className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Quick ZIP / Code Preview button (Visible on Desktop >= 1024px, also accessible in offcanvas) */}\n          <button\n            id=\"header-code-zip-btn\"\n            onClick={onOpenCodeZip}\n            className=\"hidden lg:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono-tech uppercase text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] bg-[var(--bg-card)] border border-[var(--border-color)] hover:border-[var(--accent-cyan)] rounded-lg transition-all duration-200 cursor-pointer\"\n            title=\"Preview Code & Download Project ZIP\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n            <span>Export ZIP</span>\n          </button>\n\n          {/* Universal Contact Button (Visible on Tablet/Desktop >= 768px, hidden on mobile < 768px to keep mobile header to ONLY logo + hamburger) */}\n          <button\n            id=\"header-contact-btn\"\n            onClick={onOpenContact}\n            className=\"hidden md:inline-flex gk-btn group text-xs sm:text-sm py-2 sm:py-2.5 px-3.5 sm:px-5\"\n          >\n            <Radio className=\"w-3.5 h-3.5 animate-pulse text-[var(--accent-cyan)] group-hover:text-white transition-colors\" />\n            <span>Connect Bay</span>\n          </button>\n\n          {/* Mobile & Tablet Hamburger Toggle (Requirement 3 & 5: On mobile, header has ONLY Logo + this Hamburger!) */}\n          <button\n            id=\"header-hamburger-toggle\"\n            onClick={() => setMobileMenuOpen(true)}\n            className=\"lg:hidden p-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 focus:outline-none focus:ring-2 focus:ring-[var(--accent-cyan)] cursor-pointer transition-colors\"\n            aria-label=\"Open Navigation Menu\"\n          >\n            <Menu className=\"w-6 h-6\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Offcanvas Drawer Content for Tablet & Mobile (Requirements 3 & 5) */}\n      {mobileMenuOpen && (\n        <div\n          id=\"offcanvas-navigation-overlay\"\n          className=\"fixed inset-0 z-50 flex justify-end bg-black/65 backdrop-blur-sm animate-fadeIn\"\n          onClick={() => setMobileMenuOpen(false)}\n        >\n          {/* Offcanvas Sliding Drawer Panel */}\n          <div\n            id=\"offcanvas-drawer-panel\"\n            className=\"relative w-full max-w-sm sm:max-w-md h-full bg-[var(--bg-card)] border-l border-[var(--border-color)] shadow-2xl p-6 sm:p-8 flex flex-col justify-between overflow-y-auto z-50 animate-slideLeft\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Top Bar of Offcanvas: Logo + Close Button */}\n            <div>\n              <div className=\"flex items-center justify-between pb-6 border-b border-[var(--border-color)]\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 flex items-center justify-center bg-[var(--bg-card-subtle)] border border-[var(--accent-cyan)] rounded-lg\">\n                    <span className=\"font-primary font-black text-lg text-[var(--accent-cyan)]\">GK</span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"font-primary font-extrabold text-base tracking-wider text-[var(--text-primary)]\">\n                      GK <span className=\"text-[var(--accent-cyan)]\">SERVICES</span>\n                    </span>\n                    <span className=\"text-[10px] font-mono-tech tracking-widest text-[var(--text-secondary)] uppercase\">\n                      Precision Offcanvas Hub\n                    </span>\n                  </div>\n                </div>\n\n                <button\n                  id=\"offcanvas-close-btn\"\n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"p-2 rounded-xl bg-[var(--bg-card-subtle)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer\"\n                  aria-label=\"Close Menu\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n\n              {/* Offcanvas Telemetry Status Badge */}\n              <div className=\"my-5 p-3 rounded-xl bg-[var(--bg-card-subtle)] border border-[var(--border-color)] flex items-center justify-between text-xs font-mono-tech\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n                  <span className=\"text-[var(--text-secondary)]\">Facility Status:</span>\n                </div>\n                <span className=\"text-[var(--accent-cyan)] font-bold\">12/12 BAYS ONLINE</span>\n              </div>\n\n              {/* Navigation Menu in the Offcanvas (Requirement 3) */}\n              <nav className=\"flex flex-col gap-1.5 py-2\">\n                <span className=\"text-[11px] font-mono-tech uppercase tracking-widest text-[var(--text-muted)] px-3 mb-1\">\n                  NAVIGATION SECTORS\n                </span>\n                {navLinks.map((link) => {\n                  const isActive = activeSection === link.id;\n                  return (\n                    <a\n                      key={link.id}\n                      id={`offcanvas-nav-${link.id}`}\n                      href={link.href}\n                      onClick={(e) => {\n                        e.preventDefault();\n                        handleNavClick(link.href);\n                      }}\n                      className={`flex items-center justify-between px-4 py-3 rounded-xl text-sm transition-all duration-200 ${\n                        isActive\n                          ? \'bg-[var(--accent-cyan)] text-white font-bold shadow-[0_0_20px_var(--accent-glow)]\'\n                          : \'text-[var(--text-primary)] hover:bg-[var(--bg-card-subtle)] hover:text-[var(--accent-cyan)]\'\n                      }`}\n                    >\n                      <span className=\"font-primary text-sm sm:text-base uppercase tracking-wider\">{link.label}</span>\n                      {link.badge && (\n                        <span className={`text-[10px] font-mono-tech uppercase px-2 py-0.5 rounded border ${\n                          isActive\n                            ? \'bg-white/20 text-white border-white/30\'\n                            : \'bg-[var(--accent-cyan)]/10 text-[var(--accent-cyan)] border-[var(--border-color)]\'\n                        }`}>\n                          {link.badge}\n                        </span>\n                      )}\n                    </a>\n                  );\n                })}\n              </nav>\n            </div>\n\n            {/* Bottom Actions of Offcanvas */}\n            <div className=\"pt-6 border-t border-[var(--border-color)] space-y-3\">\n              <button\n                id=\"offcanvas-contact-btn\"\n                onClick={() => {\n                  setMobileMenuOpen(false);\n                  onOpenContact();\n                }}\n                className=\"gk-btn w-full justify-center text-sm py-3 cursor-pointer\"\n              >\n                <Radio className=\"w-4 h-4 text-[var(--accent-cyan)] group-hover:text-white\" />\n                <span>Book Priority Service Dock</span>\n              </button>\n\n              <button\n                id=\"offcanvas-zip-btn\"\n                onClick={() => {\n                  setMobileMenuOpen(false);\n                  onOpenCodeZip();\n                }}\n                className=\"w-full flex items-center justify-center gap-2 py-3 px-4 bg-[var(--bg-card-subtle)] border border-[var(--border-color)] hover:border-[var(--accent-cyan)] text-xs font-mono-tech uppercase text-[var(--accent-cyan)] rounded-xl transition-all cursor-pointer\"\n              >\n                <Code2 className=\"w-4 h-4\" />\n                <span>Inspect Source & Export ZIP</span>\n              </button>\n\n              <div className=\"text-center pt-2 text-[11px] font-mono-tech text-[var(--text-muted)]\">\n                <span>Emergency AI Dispatch: +1 (800) 457-CYBER \302\267 Dock #04</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { createPortal } from \'react-dom\';\nimport { Menu, X, Shield, Radio, Sparkles, Code2, Download, Sun, Moon, ArrowRight, Activity } from \'lucide-react\';\n\ninterface HeaderProps {\n  theme: \'dark\' | \'light\';\n  onToggleTheme: () => void;\n  onOpenContact: () => void;\n  onOpenCodeZip: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ theme, onToggleTheme, onOpenContact, onOpenCodeZip }) => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [activeSection, setActiveSection] = useState(\'hero\');\n\n  // Prevent background scrolling when offcanvas menu is open\n  useEffect(() => {\n    if (mobileMenuOpen) {\n      document.body.style.overflow = \'hidden\';\n    } else {\n      document.body.style.overflow = \'\';\n    }\n    return () => {\n      document.body.style.overflow = \'\';\n    };\n  }, [mobileMenuOpen]);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 20);\n\n      const sections = [\'hero\', \'inspection360\', \'services\', \'technology\', \'calculator\', \'reviews\'];\n      const scrollPos = window.scrollY + 200;\n\n      for (const section of sections) {\n        const el = document.getElementById(section);\n        if (el) {\n          const top = el.offsetTop;\n          const height = el.offsetHeight;\n          if (scrollPos >= top && scrollPos < top + height) {\n            setActiveSection(section);\n            break;\n          }\n        }\n      }\n    };\n\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  // Concise, spacious navigation headings to eliminate congestion\n  const navLinks = [\n    { label: \'Overview\', href: \'#hero\', id: \'hero\', index: \'01\', desc: \'Mission & Facility\' },\n    { label: \'3D Inspection\', href: \'#inspection360\', id: \'inspection360\', index: \'02\', desc: \'Sports Car & WebGL\' },\n    { label: \'Services\', href: \'#services\', id: \'services\', index: \'03\', desc: \'Calibration & Ceramic\' },\n    { label: \'Technology\', href: \'#technology\', id: \'technology\', index: \'04\', desc: \'Robotic Docks\' },\n    { label: \'Estimator\', href: \'#calculator\', id: \'calculator\', index: \'05\', desc: \'Instant Live Pricing\' },\n    { label: \'Reviews\', href: \'#reviews\', id: \'reviews\', index: \'06\', desc: \'Customer Telemetry\' },\n  ];\n\n  const handleNavClick = (href: string) => {\n    setMobileMenuOpen(false);\n    const element = document.querySelector(href);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      id=\"main-header\"\n      className={`sticky top-0 z-50 w-full transition-all duration-300 ${\n        isScrolled\n          ? \'bg-[var(--bg-card)]/90 backdrop-blur-xl border-b border-[var(--border-color)] shadow-[0_10px_30px_rgba(0,0,0,0.3)]\'\n          : \'bg-gradient-to-b from-[var(--bg-primary)] via-[var(--bg-primary)]/85 to-transparent border-b border-transparent\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n        {/* Division 1: Logo Gk */}\n        <div id=\"header-logo-division\" className=\"flex items-center gap-3\">\n          <a\n            href=\"#hero\"\n            onClick={(e) => {\n              e.preventDefault();\n              handleNavClick(\'#hero\');\n            }}\n            className=\"group flex items-center gap-3 cursor-pointer\"\n          >\n            {/* Futuristic GK Hex Icon */}\n            <div className=\"relative w-11 h-11 flex items-center justify-center bg-[var(--bg-card)] border border-[var(--accent-cyan)]/50 rounded-lg overflow-hidden group-hover:border-[var(--accent-cyan)] group-hover:shadow-[0_0_20px_var(--accent-glow)] transition-all duration-300\">\n              <div className=\"absolute inset-0 bg-gradient-to-br from-[var(--accent-cyan)]/20 to-transparent opacity-60 group-hover:opacity-100 transition-opacity\" />\n              <span className=\"font-primary font-black text-xl tracking-tighter text-[var(--accent-cyan)] group-hover:scale-110 transition-transform\">\n                GK\n              </span>\n              <div className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-[var(--accent-cyan)]\" />\n            </div>\n\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"font-primary font-extrabold text-lg sm:text-xl tracking-wider text-[var(--text-primary)]\">\n                  GK <span className=\"text-[var(--accent-cyan)]\">SERVICES</span>\n                </span>\n                <span className=\"hidden sm:inline-block px-1.5 py-0.5 text-[9px] font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--accent-cyan)] border border-[var(--border-color)] rounded\">\n                  v3.4.0\n                </span>\n              </div>\n              <span className=\"text-[10px] font-mono-tech tracking-widest text-[var(--text-secondary)] uppercase\">\n                Autonomous Precision Center\n              </span>\n            </div>\n          </a>\n        </div>\n\n        {/* Division 2: Clean, Uncongested Navigation Menu (Desktop view >= 1024px) */}\n        <nav\n          id=\"header-nav-division\"\n          className=\"hidden lg:flex items-center gap-1 xl:gap-2 px-3 py-1.5 bg-[var(--bg-card)] border border-[var(--border-color)] rounded-full backdrop-blur-md shadow-sm\"\n        >\n          {navLinks.map((link) => {\n            const isActive = activeSection === link.id;\n            return (\n              <a\n                key={link.id}\n                id={`nav-link-${link.id}`}\n                href={link.href}\n                onClick={(e) => {\n                  e.preventDefault();\n                  handleNavClick(link.href);\n                }}\n                className={`px-3.5 py-1.5 rounded-full text-xs xl:text-sm font-semibold tracking-wide transition-all duration-200 ${\n                  isActive\n                    ? \'text-white bg-[var(--accent-cyan)] shadow-[0_0_15px_var(--accent-glow)]\'\n                    : \'text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10\'\n                }`}\n              >\n                <span>{link.label}</span>\n              </a>\n            );\n          })}\n        </nav>\n\n        {/* Division 3: Actions + Mobile/Tablet Hamburger Toggle */}\n        <div id=\"header-contact-division\" className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Quick ZIP / Code Preview button (Strictly hidden on Mobile & Tablet < 1024px) */}\n          <button\n            id=\"header-code-zip-btn\"\n            onClick={onOpenCodeZip}\n            className=\"hidden lg:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono-tech uppercase text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] bg-[var(--bg-card)] border border-[var(--border-color)] hover:border-[var(--accent-cyan)] rounded-lg transition-all duration-200 cursor-pointer\"\n            title=\"Preview Code & Download Project ZIP\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n            <span>Export ZIP</span>\n          </button>\n\n          {/* Universal Contact Button (Strictly hidden on Mobile & Tablet < 1024px to keep mobile header to ONLY Logo + Hamburger) */}\n          <button\n            id=\"header-contact-btn\"\n            onClick={onOpenContact}\n            className=\"hidden lg:inline-flex gk-btn group text-xs sm:text-sm py-2 sm:py-2.5 px-4 sm:px-5\"\n          >\n            <Radio className=\"w-3.5 h-3.5 animate-pulse text-[var(--accent-cyan)] group-hover:text-white transition-colors\" />\n            <span>Connect Bay</span>\n          </button>\n\n          {/* Mobile & Tablet Hamburger Toggle (On mobile & tablet, header contains ONLY Logo + this Hamburger!) */}\n          <button\n            id=\"header-hamburger-toggle\"\n            onClick={() => setMobileMenuOpen(true)}\n            className=\"lg:hidden p-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 focus:outline-none focus:ring-2 focus:ring-[var(--accent-cyan)] cursor-pointer transition-colors shadow-sm\"\n            aria-label=\"Open Navigation Menu\"\n          >\n            <Menu className=\"w-6 h-6\" />\n          </button>\n        </div>\n      </div>\n\n      {/* True Overlapping Offcanvas Drawer rendered via React Portal directly onto document.body */}\n      {mobileMenuOpen && typeof document !== \'undefined\' && createPortal(\n        <div\n          id=\"offcanvas-navigation-overlay\"\n          className=\"fixed inset-0 z-[99999] flex justify-end bg-black/80 backdrop-blur-md transition-opacity duration-300 animate-fadeIn\"\n          onClick={() => setMobileMenuOpen(false)}\n        >\n          {/* Offcanvas Sliding Drawer Panel - Covers full height and overlaps all content */}\n          <div\n            id=\"offcanvas-drawer-panel\"\n            className=\"relative w-full max-w-sm sm:max-w-md h-[100dvh] bg-[var(--bg-card)] border-l border-[var(--border-color)] shadow-[0_0_80px_rgba(0,0,0,0.8)] p-6 sm:p-8 flex flex-col justify-between overflow-y-auto z-[100000] animate-slideLeft\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Top Bar of Offcanvas: Logo + Close Button */}\n            <div>\n              <div className=\"flex items-center justify-between pb-6 border-b border-[var(--border-color)]\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 flex items-center justify-center bg-[var(--bg