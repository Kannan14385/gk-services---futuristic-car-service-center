    instruction: "Update global color variables for dark mode and light mode as requested"
    replacement_infos {
      original_chunk {
        target_content: "    /* Light Mode Variables (Crisp Racing Titanium & Electric Cobalt) */\n    --bg-primary: #f3f6fa;\n    --bg-secondary: #e8edf5;\n    --bg-card: #ffffff;\n    --bg-card-subtle: #edf2f9;\n    --bg-card-overlay: rgba(255, 255, 255, 0.94);\n    --text-primary: #090e1c;\n    --text-secondary: #334155;\n    --text-muted: #64748b;\n    --border-color: rgba(37, 99, 235, 0.16);\n    --border-highlight: rgba(37, 99, 235, 0.55);\n    --accent-cyan: #1d4ed8;\n    --accent-cyan-light: #2563eb;\n    --accent-glow: rgba(37, 99, 235, 0.28);\n    --grid-line: rgba(37, 99, 235, 0.05);\n  }\n\n  html.dark {\n    /* DARK MODE: Primary Font Kanit - 600 */\n    --font-primary: \'Kanit\', system-ui, -apple-system, sans-serif;\n    --font-secondary: \'Kanit\', system-ui, sans-serif;\n    --font-body: \'Kanit\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n    --font-weight-primary: 600;\n\n    --bg-primary: #07090e;\n    --bg-secondary: #0a0e17;\n    --bg-card: #0d1322;\n    --bg-card-subtle: #090e18;\n    --bg-card-overlay: rgba(13, 19, 34, 0.85);\n    --text-primary: #f8fafc;\n    --text-secondary: #cbd5e1;\n    --text-muted: #94a3b8;\n    --border-color: rgba(0, 240, 255, 0.22);\n    --border-highlight: rgba(0, 240, 255, 0.55);\n    --accent-cyan: #00f0ff;\n    --accent-cyan-light: #38bdf8;\n    --accent-glow: rgba(0, 240, 255, 0.45);\n    --grid-line: rgba(0, 240, 255, 0.04);\n  }"
        replacement_content: "    /* Light Mode: primary #252642, secondary #8A6A4A */\n    --color-primary: #252642;\n    --color-secondary: #8A6A4A;\n    --bg-primary: #f5f6fa;\n    --bg-secondary: #eaeef6;\n    --bg-card: #ffffff;\n    --bg-card-subtle: #f0f3f9;\n    --bg-card-overlay: rgba(255, 255, 255, 0.94);\n    --text-primary: #252642;\n    --text-secondary: #474a69;\n    --text-muted: #757999;\n    --border-color: rgba(37, 38, 66, 0.16);\n    --border-highlight: rgba(138, 106, 74, 0.65);\n    --accent-cyan: #8A6A4A;\n    --accent-cyan-light: #ab8660;\n    --accent-glow: rgba(138, 106, 74, 0.35);\n    --grid-line: rgba(37, 38, 66, 0.05);\n  }\n\n  html.dark {\n    /* DARK MODE: Primary Font Kanit - 600 */\n    --font-primary: \'Kanit\', system-ui, -apple-system, sans-serif;\n    --font-secondary: \'Kanit\', system-ui, sans-serif;\n    --font-body: \'Kanit\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n    --font-weight-primary: 600;\n\n    /* Dark Mode: primary #171719, secondary #D75151 */\n    --color-primary: #171719;\n    --color-secondary: #D75151;\n    --bg-primary: #171719;\n    --bg-secondary: #1d1d21;\n    --bg-card: #222227;\n    --bg-card-subtle: #1a1a1e;\n    --bg-card-overlay: rgba(23, 23, 25, 0.92);\n    --text-primary: #f9fafb;\n    --text-secondary: #d1d5db;\n    --text-muted: #9ca3af;\n    --border-color: rgba(215, 81, 81, 0.22);\n    --border-highlight: rgba(215, 81, 81, 0.65);\n    --accent-cyan: #D75151;\n    --accent-cyan-light: #e46868;\n    --accent-glow: rgba(215, 81, 81, 0.45);\n    --grid-line: rgba(215, 81, 81, 0.05);\n  }"
      }
