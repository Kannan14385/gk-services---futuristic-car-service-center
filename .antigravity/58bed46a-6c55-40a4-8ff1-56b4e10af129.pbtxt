  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-primary: \'Orbitron\', system-ui, sans-serif;\n    --font-secondary: \'Rajdhani\', system-ui, sans-serif;\n    --font-body: \'Inter\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n\n    --color-cyan: #00f0ff;\n    --color-cyan-glow: rgba(0, 240, 255, 0.4);\n    --color-dark-bg: #07090e;\n    --color-dark-card: #0d121d;\n    --color-dark-border: rgba(0, 240, 255, 0.18);\n  }\n\n  body {\n    font-family: var(--font-body);\n    background-color: var(--color-dark-bg);\n    color: #e2e8f0;\n    overflow-x: hidden;\n  }\n\n  /* Responsive Font Sizing Rules according to prompt specs */\n  /* Mobile (<768px) */\n  @media (max-width: 767px) {\n    .gk-font-display { font-size: 2rem; line-height: 1.2; }\n    .gk-font-h2 { font-size: 1.6rem; line-height: 1.25; }\n    .gk-font-h3 { font-size: 1.25rem; line-height: 1.3; }\n    .gk-font-body { font-size: 0.9375rem; line-height: 1.5; }\n    .gk-font-sub { font-size: 0.8125rem; }\n  }\n\n  /* Tablet (768px - 1024px) */\n  @media (min-width: 768px) and (max-width: 1024px) {\n    .gk-font-display { font-size: 2.75rem; line-height: 1.15; }\n    .gk-font-h2 { font-size: 2.1rem; line-height: 1.2; }\n    .gk-font-h3 { font-size: 1.45rem; line-height: 1.3; }\n    .gk-font-body { font-size: 1rem; line-height: 1.55; }\n    .gk-font-sub { font-size: 0.875rem; }\n  }\n\n  /* Desktop (>1024px and >1200px) */\n  @media (min-width: 1025px) {\n    .gk-font-display { font-size: 3.5rem; line-height: 1.1; }\n    .gk-font-h2 { font-size: 2.5rem; line-height: 1.2; }\n    .gk-font-h3 { font-size: 1.65rem; line-height: 1.3; }\n    .gk-font-body { font-size: 1.0625rem; line-height: 1.6; }\n    .gk-font-sub { font-size: 0.9375rem; }\n  }\n\n  @media (min-width: 1201px) {\n    .gk-font-display { font-size: 4rem; line-height: 1.08; }\n    .gk-font-h2 { font-size: 2.85rem; line-height: 1.15; }\n  }\n}\n\n/* Futuristic Font Utilities */\n.font-orbitron {\n  font-family: \'Orbitron\', system-ui, sans-serif;\n}\n.font-rajdhani {\n  font-family: \'Rajdhani\', system-ui, sans-serif;\n}\n.font-mono-tech {\n  font-family: \'JetBrains Mono\', monospace;\n}\n\n/* Universal Button Style & Hover Effect (Requirement 5) */\n.gk-btn,\nbutton.gk-btn,\na.gk-btn {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  font-family: \'Orbitron\', sans-serif;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  padding: 0.75rem 1.75rem;\n  font-size: 0.875rem;\n  color: #00f0ff;\n  background: linear-gradient(135deg, rgba(0, 240, 255, 0.08) 0%, rgba(2, 132, 199, 0.04) 100%);\n  border: 1px solid rgba(0, 240, 255, 0.45);\n  clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);\n  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n  overflow: hidden;\n  cursor: pointer;\n  box-shadow: 0 0 15px rgba(0, 240, 255, 0.12), inset 0 0 10px rgba(0, 240, 255, 0.05);\n}\n\n.gk-btn::before {\n  content: \'\';\n  position: absolute;\n  top: 0;\n  left: -120%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, rgba(0, 240, 255, 0.35), transparent);\n  transition: left 0.6s ease;\n}\n\n.gk-btn:hover {\n  color: #07090e;\n  background: #00f0ff;\n  border-color: #00f0ff;\n  box-shadow: 0 0 30px rgba(0, 240, 255, 0.65), 0 0 50px rgba(0, 240, 255, 0.3);\n  transform: translateY(-2px);\n}\n\n.gk-btn:hover::before {\n  left: 120%;\n}\n\n.gk-btn-secondary {\n  color: #94a3b8;\n  background: rgba(15, 23, 42, 0.6);\n  border: 1px solid rgba(148, 163, 184, 0.25);\n  box-shadow: none;\n}\n\n.gk-btn-secondary:hover {\n  color: #00f0ff;\n  background: rgba(0, 240, 255, 0.12);\n  border-color: rgba(0, 240, 255, 0.6);\n  box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);\n}\n\n/* Universal Container Hover Effect: y-axis -30px (Requirement 8) */\n.gk-hover-lift {\n  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.45s ease;\n  will-change: transform;\n}\n\n.gk-hover-lift:hover {\n  transform: translateY(-30px);\n  box-shadow: 0 30px 60px -15px rgba(0, 240, 255, 0.25), 0 0 25px rgba(0, 240, 255, 0.15);\n  border-color: rgba(0, 240, 255, 0.55) !important;\n}\n\n/* Cybernetic Grid & Glowing scanlines */\n.cyber-grid {\n  background-size: 40px 40px;\n  background-image: \n    linear-gradient(to right, rgba(0, 240, 255, 0.04) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(0, 240, 255, 0.04) 1px, transparent 1px);\n}\n\n.cyber-radial-glow {\n  background: radial-gradient(circle at 50% 30%, rgba(0, 240, 255, 0.12) 0%, rgba(7, 9, 14, 0) 70%);\n}\n\n/* Pulse Laser Animation */\n@keyframes radar-pulse {\n  0% { transform: scale(0.9); opacity: 0.8; }\n  50% { transform: scale(1.4); opacity: 0.2; }\n  100% { transform: scale(1.8); opacity: 0; }\n}\n\n.animate-radar {\n  animation: radar-pulse 2.2s cubic-bezier(0.25, 1, 0.5, 1) infinite;\n}\n"
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-primary: \'Chakra Petch\', \'Michroma\', system-ui, sans-serif;\n    --font-secondary: \'Rajdhani\', system-ui, sans-serif;\n    --font-body: \'Inter\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n\n    /* Light Mode Variables (Entirely opposite & fully compatible with dark) */\n    --bg-primary: #f8fafc;\n    --bg-secondary: #f1f5f9;\n    --bg-card: #ffffff;\n    --bg-card-subtle: #f8fafc;\n    --bg-card-overlay: rgba(255, 255, 255, 0.85);\n    --text-primary: #090d16;\n    --text-secondary: #475569;\n    --text-muted: #64748b;\n    --border-color: rgba(2, 132, 199, 0.22);\n    --border-highlight: rgba(2, 132, 199, 0.55);\n    --accent-cyan: #0284c7;\n    --accent-cyan-light: #0369a1;\n    --accent-glow: rgba(2, 132, 199, 0.25);\n    --grid-line: rgba(2, 132, 199, 0.08);\n  }\n\n  html.dark {\n    /* Dark Mode Variables (Cyberpunk / Void Titanium) */\n    --bg-primary: #07090e;\n    --bg-secondary: #0a0e17;\n    --bg-card: #0d1322;\n    --bg-card-subtle: #090e18;\n    --bg-card-overlay: rgba(13, 19, 34, 0.85);\n    --text-primary: #f8fafc;\n    --text-secondary: #cbd5e1;\n    --text-muted: #94a3b8;\n    --border-color: rgba(0, 240, 255, 0.22);\n    --border-highlight: rgba(0, 240, 255, 0.55);\n    --accent-cyan: #00f0ff;\n    --accent-cyan-light: #38bdf8;\n    --accent-glow: rgba(0, 240, 255, 0.45);\n    --grid-line: rgba(0, 240, 255, 0.04);\n  }\n\n  body {\n    font-family: var(--font-body);\n    background-color: var(--bg-primary);\n    color: var(--text-primary);\n    overflow-x: hidden;\n    transition: background-color 0.3s ease, color 0.3s ease;\n  }\n\n  /* Responsive Font Sizing Rules according to prompt specs */\n  /* Mobile (<768px) */\n  @media (max-width: 767px) {\n    .gk-font-display { font-size: 2rem; line-height: 1.2; }\n    .gk-font-h2 { font-size: 1.6rem; line-height: 1.25; }\n    .gk-font-h3 { font-size: 1.25rem; line-height: 1.3; }\n    .gk-font-body { font-size: 0.9375rem; line-height: 1.5; }\n    .gk-font-sub { font-size: 0.8125rem; }\n  }\n\n  /* Tablet (768px - 1024px) */\n  @media (min-width: 768px) and (max-width: 1024px) {\n    .gk-font-display { font-size: 2.75rem; line-height: 1.15; }\n    .gk-font-h2 { font-size: 2.1rem; line-height: 1.2; }\n    .gk-font-h3 { font-size: 1.45rem; line-height: 1.3; }\n    .gk-font-body { font-size: 1rem; line-height: 1.55; }\n    .gk-font-sub { font-size: 0.875rem; }\n  }\n\n  /* Desktop (>1024px and >1200px) */\n  @media (min-width: 1025px) {\n    .gk-font-display { font-size: 3.5rem; line-height: 1.1; }\n    .gk-font-h2 { font-size: 2.5rem; line-height: 1.2; }\n    .gk-font-h3 { font-size: 1.65rem; line-height: 1.3; }\n    .gk-font-body { font-size: 1.0625rem; line-height: 1.6; }\n    .gk-font-sub { font-size: 0.9375rem; }\n  }\n\n  @media (min-width: 1201px) {\n    .gk-font-display { font-size: 4rem; line-height: 1.08; }\n    .gk-font-h2 { font-size: 2.85rem; line-height: 1.15; }\n  }\n}\n\n/* Primary and Secondary Font Utilities */\n.font-primary,\n.font-chakra,\n.font-orbitron {\n  font-family: var(--font-primary);\n}\n.font-rajdhani {\n  font-family: var(--font-secondary);\n}\n.font-mono-tech {\n  font-family: var(--font-mono);\n}\n\n/* Universal Button Style & Universal Hover Effect (Requirement 5) */\n.gk-btn,\nbutton.gk-btn,\na.gk-btn {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  font-family: var(--font-primary);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  padding: 0.75rem 1.75rem;\n  font-size: 0.875rem;\n  color: var(--accent-cyan);\n  background: linear-gradient(135deg, rgba(2, 132, 199, 0.08) 0%, rgba(0, 240, 255, 0.04) 100%);\n  border: 1px solid var(--border-highlight);\n  clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);\n  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n  overflow: hidden;\n  cursor: pointer;\n  box-shadow: 0 0 15px var(--accent-glow), inset 0 0 10px rgba(0, 240, 255, 0.05);\n}\n\n.gk-btn::before {\n  content: \'\';\n  position: absolute;\n  top: 0;\n  left: -120%;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);\n  opacity: 0.4;\n  transition: left 0.6s ease;\n}\n\n.gk-btn:hover {\n  color: #ffffff;\n  background: var(--accent-cyan);\n  border-color: var(--accent-cyan);\n  box-shadow: 0 0 30px var(--accent-glow), 0 0 45px rgba(2, 132, 199, 0.35);\n  transform: translateY(-2px);\n}\n\nhtml.dark .gk-btn:hover {\n  color: #07090e;\n  background: #00f0ff;\n  border-color: #00f0ff;\n  box-shadow: 0 0 30px rgba(0, 240, 255, 0.65), 0 0 50px rgba(0, 240, 255, 0.3);\n}\n\n.gk-btn:hover::before {\n  left: 120%;\n}\n\n.gk-btn-secondary {\n  color: var(--text-secondary);\n  background: var(--bg-card);\n  border: 1px solid var(--border-color);\n  box-shadow: none;\n}\n\n.gk-btn-secondary:hover {\n  color: var(--accent-cyan);\n  background: var(--bg-card-subtle);\n  border-color: var(--accent-cyan);\n  box-shadow: 0 0 20px var(--accent-glow);\n}\n\n/* Universal Container Hover Effect: y-axis -30px (Requirement 8) */\n.gk-hover-lift {\n  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.45s ease;\n  will-change: transform;\n}\n\n.gk-hover-lift:hover {\n  transform: translateY(-30px);\n  box-shadow: 0 30px 60px -15px var(--accent-glow), 0 0 25px rgba(2, 132, 199, 0.15);\n  border-color: var(--border-highlight) !important;\n}\n\n/* Cybernetic Grid & Glowing scanlines supporting Light & Dark */\n.cyber-grid {\n  background-size: 40px 40px;\n  background-image: \n    linear-gradient(to right, var(--grid-line) 1px, transparent 1px),\n    linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);\n}\n\n.cyber-radial-glow {\n  background: radial-gradient(circle at 50% 30%, var(--accent-glow) 0%, transparent 70%);\n}\n\n/* Pulse Laser Animation */\n@keyframes radar-pulse {\n  0% { transform: scale(0.9); opacity: 0.8; }\n  50% { transform: scale(1.4); opacity: 0.2; }\n  100% { transform: scale(1.8); opacity: 0; }\n}\n\n.animate-radar {\n  animation: radar-pulse 2.2s cubic-bezier(0.25, 1, 0.5, 1) infinite;\n}\n"
    }
