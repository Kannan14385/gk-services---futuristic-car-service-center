      target_content: "        {/* Division 3: Theme Toggle + Contact Button + Code/ZIP Export + Hamburger Menu */}\n        <div id=\"header-contact-division\" className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Light / Dark Mode Toggle Button */}\n          <button\n            id=\"theme-toggle-btn\"\n            onClick={onToggleTheme}\n            aria-label={`Switch to ${theme === \'dark\' ? \'Light\' : \'Dark\'} Mode`}\n            className=\"p-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] hover:shadow-[0_0_15px_var(--accent-glow)] transition-all duration-200 cursor-pointer\"\n            title={`Switch to ${theme === \'dark\' ? \'Light (Clean Aerospace White)\' : \'Dark (Cyber Titanium Void)\'} Mode`}\n          >\n            {theme === \'dark\' ? (\n              <Sun className=\"w-4 h-4 text-amber-300 animate-spin-slow\" />\n            ) : (\n              <Moon className=\"w-4 h-4 text-[var(--accent-cyan)]\" />\n            )}\n          </button>\n\n          {/* Quick ZIP / Code Preview button */}\n          <button\n            id=\"header-code-zip-btn\"\n            onClick={onOpenCodeZip}\n            className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono-tech uppercase text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] bg-[var(--bg-card)] border border-[var(--border-color)] hover:border-[var(--accent-cyan)] rounded-lg transition-all duration-200 cursor-pointer\"\n            title=\"Preview Code & Download Project ZIP\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n            <span>Export ZIP</span>\n          </button>\n\n          {/* Universal Contact Button with Glowing Hover (Requirement 5) */}\n          <button\n            id=\"header-contact-btn\"\n            onClick={onOpenContact}\n            className=\"gk-btn group text-xs sm:text-sm py-2 sm:py-2.5 px-4 sm:px-6\"\n          >\n            <Radio className=\"w-3.5 h-3.5 animate-pulse text-[var(--accent-cyan)] group-hover:text-white transition-colors\" />\n            <span>Connect Bay</span>\n          </button>\n\n          {/* Mobile / Tablet Hamburger Toggle (Requirement 9) */}\n          <button\n            id=\"header-hamburger-toggle\"\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"lg:hidden p-2 rounded-lg bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 focus:outline-none focus:ring-2 focus:ring-[var(--accent-cyan)] cursor-pointer\"\n            aria-label=\"Toggle Navigation Menu\"\n          >\n            {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile & Tablet Drawer (Requirement 9) */}\n      {mobileMenuOpen && (\n        <div\n          id=\"mobile-drawer-menu\"\n          className=\"lg:hidden bg-[var(--bg-card)]/95 backdrop-blur-2xl border-b border-[var(--border-color)] px-6 py-6 transition-all duration-300 shadow-2xl\"\n        >\n          <div className=\"flex flex-col gap-2 pb-4 border-b border-[var(--border-color)]\">\n            <div className=\"flex items-center justify-between pb-2\">\n              <span className=\"text-xs font-mono-tech text-[var(--accent-cyan)] tracking-widest uppercase\">\n                TELEMETRY NAVIGATION\n              </span>\n              <button\n                onClick={onToggleTheme}\n                className=\"flex items-center gap-1.5 px-2.5 py-1 rounded bg-[var(--bg-primary)] border border-[var(--border-color)] text-xs font-mono-tech text-[var(--accent-cyan)]\"\n              >\n                {theme === \'dark\' ? <Sun className=\"w-3.5 h-3.5 text-amber-300\" /> : <Moon className=\"w-3.5 h-3.5\" />}\n                <span>{theme === \'dark\' ? \'Light Theme\' : \'Dark Theme\'}</span>\n              </button>\n            </div>\n\n            {navLinks.map((link) => {\n              const isActive = activeSection === link.id;\n              return (\n                <a\n                  key={link.id}\n                  id={`mobile-nav-${link.id}`}\n                  href={link.href}\n                  onClick={(e) => {\n                    e.preventDefault();\n                    handleNavClick(link.href);\n                  }}\n                  className={`flex items-center justify-between px-4 py-3 rounded-lg text-sm font-medium transition-all ${\n                    isActive\n                      ? \'bg-[var(--accent-cyan)] text-white font-semibold shadow-[0_0_15px_var(--accent-glow)]\'\n                      : \'text-[var(--text-primary)] hover:text-[var(--accent-cyan)] hover:bg-[var(--bg-primary)]\'\n                  }`}\n                >\n                  <span className=\"font-rajdhani text-base tracking-wide uppercase\">{link.label}</span>\n                  {link.badge && (\n                    <span className=\"text-[10px] font-mono-tech uppercase bg-[var(--accent-cyan)]/20 text-[var(--accent-cyan)] px-2 py-0.5 rounded border border-[var(--border-color)]\">\n                      {link.badge}\n                    </span>\n                  )}\n                </a>\n              );\n            })}\n          </div>\n\n          <div className=\"pt-4 flex flex-col gap-3\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenCodeZip();\n              }}\n              className=\"w-full flex items-center justify-center gap-2 py-2.5 px-4 bg-[var(--bg-primary)] border border-[var(--border-color)] text-xs font-mono-tech text-[var(--accent-cyan)] rounded-lg hover:border-[var(--accent-cyan)]\"\n            >\n              <Code2 className=\"w-4 h-4\" />\n              <span>Inspect Source & Download ZIP</span>\n            </button>\n\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenContact();\n              }}\n              className=\"gk-btn w-full justify-center text-sm py-3\"\n            >\n              <Radio className=\"w-4 h-4\" />\n              <span>Book Priority Service Dock</span>\n            </button>\n          </div>\n        </div>\n      )}"
      replacement_content: "        {/* Division 3: Actions + Mobile/Tablet Hamburger Toggle */}\n        <div id=\"header-contact-division\" className=\"flex items-center gap-2 sm:gap-3\">\n          {/* Quick ZIP / Code Preview button (Visible on Desktop >= 1024px, also accessible in offcanvas) */}\n          <button\n            id=\"header-code-zip-btn\"\n            onClick={onOpenCodeZip}\n            className=\"hidden lg:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono-tech uppercase text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] bg-[var(--bg-card)] border border-[var(--border-color)] hover:border-[var(--accent-cyan)] rounded-lg transition-all duration-200 cursor-pointer\"\n            title=\"Preview Code & Download Project ZIP\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n            <span>Export ZIP</span>\n          </button>\n\n          {/* Universal Contact Button (Visible on Tablet/Desktop >= 768px, hidden on mobile < 768px to keep mobile header to ONLY logo + hamburger) */}\n          <button\n            id=\"header-contact-btn\"\n            onClick={onOpenContact}\n            className=\"hidden md:inline-flex gk-btn group text-xs sm:text-sm py-2 sm:py-2.5 px-3.5 sm:px-5\"\n          >\n            <Radio className=\"w-3.5 h-3.5 animate-pulse text-[var(--accent-cyan)] group-hover:text-white transition-colors\" />\n            <span>Connect Bay</span>\n          </button>\n\n          {/* Mobile & Tablet Hamburger Toggle (Requirement 3 & 5: On mobile, header has ONLY Logo + this Hamburger!) */}\n          <button\n            id=\"header-hamburger-toggle\"\n            onClick={() => setMobileMenuOpen(true)}\n            className=\"lg:hidden p-2.5 rounded-xl bg-[var(--bg-card)] border border-[var(--border-color)] text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 focus:outline-none focus:ring-2 focus:ring-[var(--accent-cyan)] cursor-pointer transition-colors\"\n            aria-label=\"Open Navigation Menu\"\n          >\n            <Menu className=\"w-6 h-6\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Offcanvas Drawer Content for Tablet & Mobile (Requirements 3 & 5) */}\n      {mobileMenuOpen && (\n        <div\n          id=\"offcanvas-navigation-overlay\"\n          className=\"fixed inset-0 z-50 flex justify-end bg-black/65 backdrop-blur-sm animate-fadeIn\"\n          onClick={() => setMobileMenuOpen(false)}\n        >\n          {/* Offcanvas Sliding Drawer Panel */}\n          <div\n            id=\"offcanvas-drawer-panel\"\n            className=\"relative w-full max-w-sm sm:max-w-md h-full bg-[var(--bg-card)] border-l border-[var(--border-color)] shadow-2xl p-6 sm:p-8 flex flex-col justify-between overflow-y-auto z-50 animate-slideLeft\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            {/* Top Bar of Offcanvas: Logo + Close Button */}\n            <div>\n              <div className=\"flex items-center justify-between pb-6 border-b border-[var(--border-color)]\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"w-10 h-10 flex items-center justify-center bg-[var(--bg-card-subtle)] border border-[var(--accent-cyan)] rounded-lg\">\n                    <span className=\"font-primary font-black text-lg text-[var(--accent-cyan)]\">GK</span>\n                  </div>\n                  <div className=\"flex flex-col\">\n                    <span className=\"font-primary font-extrabold text-base tracking-wider text-[var(--text-primary)]\">\n                      GK <span className=\"text-[var(--accent-cyan)]\">SERVICES</span>\n                    </span>\n                    <span className=\"text-[10px] font-mono-tech tracking-widest text-[var(--text-secondary)] uppercase\">\n                      Precision Offcanvas Hub\n                    </span>\n                  </div>\n                </div>\n\n                <button\n                  id=\"offcanvas-close-btn\"\n                  onClick={() => setMobileMenuOpen(false)}\n                  className=\"p-2 rounded-xl bg-[var(--bg-card-subtle)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer\"\n                  aria-label=\"Close Menu\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n\n              {/* Offcanvas Telemetry Status Badge */}\n              <div className=\"my-5 p-3 rounded-xl bg-[var(--bg-card-subtle)] border border-[var(--border-color)] flex items-center justify-between text-xs font-mono-tech\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n                  <span className=\"text-[var(--text-secondary)]\">Facility Status:</span>\n                </div>\n                <span className=\"text-[var(--accent-cyan)] font-bold\">12/12 BAYS ONLINE</span>\n              </div>\n\n              {/* Navigation Menu in the Offcanvas (Requirement 3) */}\n              <nav className=\"flex flex-col gap-1.5 py-2\">\n                <span className=\"text-[11px] font-mono-tech uppercase tracking-widest text-[var(--text-muted)] px-3 mb-1\">\n                  NAVIGATION SECTORS\n                </span>\n                {navLinks.map((link) => {\n                  const isActive = activeSection === link.id;\n                  return (\n                    <a\n                      key={link.id}\n                      id={`offcanvas-nav-${link.id}`}\n                      href={link.href}\n                      onClick={(e) => {\n                        e.preventDefault();\n                        handleNavClick(link.href);\n                      }}\n                      className={`flex items-center justify-between px-4 py-3 rounded-xl text-sm transition-all duration-200 ${\n                        isActive\n                          ? \'bg-[var(--accent-cyan)] text-white font-bold shadow-[0_0_20px_var(--accent-glow)]\'\n                          : \'text-[var(--text-primary)] hover:bg-[var(--bg-card-subtle)] hover:text-[var(--accent-cyan)]\'\n                      }`}\n                    >\n                      <span className=\"font-primary text-sm sm:text-base uppercase tracking-wider\">{link.label}</span>\n                      {link.badge && (\n                        <span className={`text-[10px] font-mono-tech uppercase px-2 py-0.5 rounded border ${\n                          isActive\n                            ? \'bg-white/20 text-white border-white/30\'\n                            : \'bg-[var(--accent-cyan)]/10 text-[var(--accent-cyan)] border-[var(--border-color)]\'\n                        }`}>\n                          {link.badge}\n                        </span>\n                      )}\n                    </a>\n                  );\n                })}\n              </nav>\n            </div>\n\n            {/* Bottom Actions of Offcanvas */}\n            <div className=\"pt-6 border-t border-[var(--border-color)] space-y-3\">\n              <button\n                id=\"offcanvas-contact-btn\"\n                onClick={() => {\n                  setMobileMenuOpen(false);\n                  onOpenContact();\n                }}\n                className=\"gk-btn w-full justify-center text-sm py-3 cursor-pointer\"\n              >\n                <Radio className=\"w-4 h-4 text-[var(--accent-cyan)] group-hover:text-white\" />\n                <span>Book Priority Service Dock</span>\n              </button>\n\n              <button\n                id=\"offcanvas-zip-btn\"\n                onClick={() => {\n                  setMobileMenuOpen(false);\n                  onOpenCodeZip();\n                }}\n                className=\"w-full flex items-center justify-center gap-2 py-3 px-4 bg-[var(--bg-card-subtle)] border border-[var(--border-color)] hover:border-[var(--accent-cyan)] text-xs font-mono-tech uppercase text-[var(--accent-cyan)] rounded-xl transition-all cursor-pointer\"\n              >\n                <Code2 className=\"w-4 h-4\" />\n                <span>Inspect Source & Export ZIP</span>\n              </button>\n\n              <div className=\"text-center pt-2 text-[11px] font-mono-tech text-[var(--text-muted)]\">\n                <span>Emergency AI Dispatch: +1 (800) 457-CYBER \302\267 Dock #04</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}"
