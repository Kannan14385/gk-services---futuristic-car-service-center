  file_change {
    absolute_path_uri: "file:///src/components/CodePreviewAndZipModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Download, Copy, Check, Code2, FileCode, Sparkles, FolderArchive, Terminal } from \'lucide-react\';\nimport JSZip from \'jszip\';\n\ninterface CodePreviewAndZipModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const CodePreviewAndZipModal: React.FC<CodePreviewAndZipModalProps> = ({ isOpen, onClose }) => {\n  const [activeTab, setActiveTab] = useState<\'App.tsx\' | \'index.html\' | \'index.css\' | \'mockCarData.ts\' | \'README.md\'>(\'App.tsx\');\n  const [isCopied, setIsCopied] = useState(false);\n  const [isZipping, setIsZipping] = useState(false);\n  const [zipSuccess, setZipSuccess] = useState(false);\n\n  if (!isOpen) return null;\n\n  const codeSnippets: Record<string, string> = {\n    \'App.tsx\': `/**\n * GK SERVICES - Futuristic Professional Car Service Center Webpage\n * Generated with full responsive breakpoints, 360\302\260 interactive car inspection,\n * before/after service enhancement hotspots, and -30px container hover dynamics.\n */\nimport React, { useState } from \'react\';\nimport { Header } from \'./components/Header\';\nimport { HeroSection } from \'./components/HeroSection\';\nimport { Car360Viewer } from \'./components/Car360Viewer\';\nimport { ServicesSection } from \'./components/ServicesSection\';\nimport { TechBaySection } from \'./components/TechBaySection\';\nimport { CostCalculatorSection } from \'./components/CostCalculatorSection\';\nimport { TestimonialsFaqSection } from \'./components/TestimonialsFaqSection\';\nimport { Footer } from \'./components/Footer\';\nimport { BeforeAfterModal } from \'./components/BeforeAfterModal\';\nimport { ContactModal } from \'./components/ContactModal\';\nimport { CarHotspot } from \'./types\';\n\nexport default function App() {\n  const [selectedHotspot, setSelectedHotspot] = useState<CarHotspot | null>(null);\n  const [contactModalOpen, setContactModalOpen] = useState<boolean>(false);\n  const [prefillContact, setPrefillContact] = useState<any>(null);\n\n  const handleBookService = (serviceName: string) => {\n    setPrefillContact({ serviceName });\n    setContactModalOpen(true);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#07090e] text-[#e2e8f0]\">\n      {/* 1. Sticky Header with 3 Divisions */}\n      <Header\n        onOpenContact={() => setContactModalOpen(true)}\n        onOpenCodeZip={() => {}}\n      />\n\n      {/* 2. Section 01: Hero Mission Hub */}\n      <HeroSection\n        onOpenContact={() => setContactModalOpen(true)}\n        onExplore360={() => {\n          document.getElementById(\'inspection360\')?.scrollIntoView({ behavior: \'smooth\' });\n        }}\n      />\n\n      {/* 3. Section 02: 360\302\260 Rotatable Car Visualizer & Hotspots */}\n      <Car360Viewer onSelectHotspot={(hotspot) => setSelectedHotspot(hotspot)} />\n\n      {/* 4. Section 03: Core Engineering & Diagnostics Matrix */}\n      <ServicesSection onBookService={handleBookService} />\n\n      {/* 5. Section 04: Robotic Cleanroom Bays */}\n      <TechBaySection />\n\n      {/* 6. Section 05: Cost Estimator & Terminal */}\n      <CostCalculatorSection\n        onOpenBookingModal={(data) => {\n          setPrefillContact(data);\n          setContactModalOpen(true);\n        }}\n      />\n\n      {/* 7. Section 06: Fleet Testimonials & FAQ */}\n      <TestimonialsFaqSection />\n\n      {/* 8. Professional Futuristic Footer */}\n      <Footer onOpenContact={() => setContactModalOpen(true)} />\n\n      {/* Hotspot Before / After Inspection Popup */}\n      <BeforeAfterModal\n        hotspot={selectedHotspot}\n        onClose={() => setSelectedHotspot(null)}\n        onBookService={handleBookService}\n      />\n\n      {/* Contact & Dock Terminal Modal */}\n      <ContactModal\n        isOpen={contactModalOpen}\n        onClose={() => setContactModalOpen(false)}\n        prefillData={prefillContact}\n      />\n    </div>\n  );\n}`,\n    \'index.html\': `<!doctype html>\n<html lang=\"en\" class=\"dark scroll-smooth\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>GK Services - Futuristic Car Service Center</title>\n    <meta name=\"description\" content=\"Next-generation automotive engineering with 360\302\260 interactive car inspection and before/after service enhancement.\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@400;700&family=Orbitron:wght@600;800;900&family=Rajdhani:wght@600;700&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-[#07090e] text-[#e2e8f0] antialiased selection:bg-[#00f0ff] selection:text-[#07090e]\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>`,\n    \'index.css\': `@import \"tailwindcss\";\n\n/* Responsive Typography Rules */\n@media (max-width: 767px) {\n  .gk-font-display { font-size: 2rem; line-height: 1.2; }\n}\n@media (min-width: 768px) and (max-width: 1024px) {\n  .gk-font-display { font-size: 2.75rem; line-height: 1.15; }\n}\n@media (min-width: 1025px) {\n  .gk-font-display { font-size: 3.5rem; line-height: 1.1; }\n}\n@media (min-width: 1201px) {\n  .gk-font-display { font-size: 4rem; line-height: 1.08; }\n}\n\n/* Universal Button Style & Universal Hover Effect */\n.gk-btn {\n  font-family: \'Orbitron\', sans-serif;\n  color: #00f0ff;\n  border: 1px solid rgba(0, 240, 255, 0.45);\n  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.gk-btn:hover {\n  color: #07090e;\n  background: #00f0ff;\n  box-shadow: 0 0 30px rgba(0, 240, 255, 0.65);\n}\n\n/* Universal Container Hover Effect: y-axis -30px (Requirement 8) */\n.gk-hover-lift {\n  transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.45s ease;\n}\n.gk-hover-lift:hover {\n  transform: translateY(-30px);\n  box-shadow: 0 30px 60px -15px rgba(0, 240, 255, 0.25);\n}`,\n    \'mockCarData.ts\': `// 360 Perspectives & Hotspot Before/After Data\nexport const CAR_360_ANGLES = [\n  { angle: 0, label: \'Front Direct\', src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1400&q=80\' },\n  { angle: 45, label: \'Front Quarter Right\', src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1400&q=80\' },\n  { angle: 90, label: \'Profile Side Right\', src: \'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1400&q=80\' },\n  { angle: 180, label: \'Rear Direct\', src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1400&q=80\' }\n];\n\nexport const CAR_HOTSPOTS = [\n  {\n    id: \'spot-paint\',\n    name: \'Ceramic 9H Nano-Shield Paint\',\n    part: \'Front Hood & Aerodynamic Cowl\',\n    before: { status: \'Micro-scratched & Acid-Rain Etched\', conditionScore: 38 },\n    after: { status: \'9H Diamond-Mirror Hydrophobic Shield\', conditionScore: 99 }\n  },\n  {\n    id: \'spot-brakes\',\n    name: \'Carbon-Ceramic Calipers & Rotors\',\n    part: \'Front Left Wheel Assembly\',\n    before: { status: \'Corroded Rotors & Glazed Brake Pads\', conditionScore: 42 },\n    after: { status: \'Zero-Tolerance Monobloc Carbon Overhaul\', conditionScore: 100 }\n  }\n];`,\n    \'README.md\': `# GK Services - Futuristic Car Service Center\n\nA next-generation, high-performance static web application engineered with React 19, TypeScript, and Tailwind CSS.\n\n## Key Features & User Requirements Fulfilled\n1. **Brand**: GK Services Car Service Center.\n2. **Responsive Typography**: Breakpoints for Desktop (>1200px), Tablet (>1024px), Mobile (>767px).\n3. **Cyber Dual Palette**: Electric Cyan (#00F0FF) & Deep Void Obsidian (#07090E).\n4. **6 Distinct Sections**:\n   - Section 01: Hero Telemetry & Mission Control\n   - Section 02: 360\302\260 Interactive Vehicle Inspection & Before/After Hotspots\n   - Section 03: Core Engineering & Diagnostics Matrix\n   - Section 04: Robotic Cleanroom Bays & Live Sensor Feeds\n   - Section 05: Transparent Service Terminal & Estimator\n   - Section 06: Client Telemetry & FAQ\n5. **Sticky Header**: 3 divisions (GK Logo, Nav Menu, Universal Contact Button).\n6. **Container Hover Lift**: All key cards and containers lift -30px on hover (\\`transform: translateY(-30px)\\`).\n7. **Responsive Hamburger Navigation**: Automatically collapses into a drawer on tablet and mobile.\n8. **360\302\260 Playful Car Visualizer**: Drag, scroll, or slider to rotate with clickable before/after comparison modals.\n9. **Export & Edit**: 1-Click ZIP generator directly from the webpage.\n\n## Quick Start\n\\`\\`\\`bash\nnpm install\nnpm run dev\n\\`\\`\\`\n`\n  };\n\n  const handleCopy = () => {\n    navigator.clipboard.writeText(codeSnippets[activeTab]);\n    setIsCopied(true);\n    setTimeout(() => setIsCopied(false), 2000);\n  };\n\n  const handleDownloadZip = async () => {\n    try {\n      setIsZipping(true);\n      const zip = new JSZip();\n\n      // Add project files to zip\n      zip.file(\'README.md\', codeSnippets[\'README.md\']);\n      zip.file(\'index.html\', codeSnippets[\'index.html\']);\n      zip.file(\'src/App.tsx\', codeSnippets[\'App.tsx\']);\n      zip.file(\'src/index.css\', codeSnippets[\'index.css\']);\n      zip.file(\'src/data/mockCarData.ts\', codeSnippets[\'mockCarData.ts\']);\n      zip.file(\'package.json\', JSON.stringify({\n        name: \"gk-services-futuristic-webpage\",\n        version: \"1.0.0\",\n        scripts: {\n          \"dev\": \"vite\",\n          \"build\": \"vite build\",\n          \"preview\": \"vite preview\"\n        },\n        dependencies: {\n          \"react\": \"^19.0.0\",\n          \"react-dom\": \"^19.0.0\",\n          \"lucide-react\": \"^0.546.0\",\n          \"jszip\": \"^3.10.1\"\n        }\n      }, null, 2));\n\n      const content = await zip.generateAsync({ type: \'blob\' });\n      const url = window.URL.createObjectURL(content);\n      const link = document.createElement(\'a\');\n      link.href = url;\n      link.download = \'gk-services-futuristic-webpage.zip\';\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      window.URL.revokeObjectURL(url);\n\n      setZipSuccess(true);\n      setTimeout(() => setZipSuccess(false), 3000);\n    } catch (err) {\n      console.error(\'Error bundling ZIP:\', err);\n    } finally {\n      setIsZipping(false);\n    }\n  };\n\n  return (\n    <div\n      id=\"code-preview-modal-backdrop\"\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 bg-black/85 backdrop-blur-xl animate-fadeIn\"\n      onClick={(e) => {\n        if (e.target === e.currentTarget) onClose();\n      }}\n    >\n      <div\n        id=\"code-preview-modal-container\"\n        className=\"relative w-full max-w-4xl max-h-[90vh] flex flex-col bg-[#0a0e17] border border-[#00f0ff]/50 rounded-2xl shadow-[0_0_50px_rgba(0,240,255,0.3)] overflow-hidden\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"px-6 py-4 border-b border-[#00f0ff]/20 flex items-center justify-between bg-gradient-to-r from-[#0d1322] via-[#0a0e17] to-[#0d1322]\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-2 rounded-lg bg-[#00f0ff]/10 border border-[#00f0ff]/30 text-[#00f0ff]\">\n              <Code2 className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono-tech uppercase tracking-widest text-[#00f0ff]\">\n                SOURCE INSPECTOR & BUNDLER\n              </span>\n              <h3 className=\"font-orbitron font-bold text-lg text-white\">\n                PROJECT CODE & 1-CLICK ZIP\n              </h3>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            {/* 1-Click ZIP Download button */}\n            <button\n              id=\"download-project-zip-btn\"\n              onClick={handleDownloadZip}\n              disabled={isZipping}\n              className=\"gk-btn text-xs py-2 px-4 flex items-center gap-1.5\"\n            >\n              {isZipping ? (\n                <span>Generating ZIP...</span>\n              ) : zipSuccess ? (\n                <>\n                  <Check className=\"w-4 h-4 text-[#07090e]\" />\n                  <span>ZIP Downloaded!</span>\n                </>\n              ) : (\n                <>\n                  <Download className=\"w-4 h-4\" />\n                  <span>Download Complete ZIP</span>\n                </>\n              )}\n            </button>\n\n            <button\n              onClick={onClose}\n              className=\"p-2 text-[#94a3b8] hover:text-[#00f0ff] hover:bg-[#00f0ff]/10 rounded-lg transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Tab Selection */}\n        <div className=\"px-6 pt-3 pb-1 border-b border-[#00f0ff]/15 bg-[#07090e] flex items-center justify-between overflow-x-auto gap-2\">\n          <div className=\"flex items-center gap-2\">\n            {(Object.keys(codeSnippets) as (keyof typeof codeSnippets)[]).map((tab) => (\n              <button\n                key={tab}\n                onClick={() => setActiveTab(tab)}\n                className={`px-3 py-1.5 rounded-t-lg text-xs font-mono-tech transition-all flex items-center gap-1.5 ${\n                  activeTab === tab\n                    ? \'bg-[#0d1322] text-[#00f0ff] border-t-2 border-x border-[#00f0ff]/40 font-semibold\'\n                    : \'text-[#94a3b8] hover:text-white\'\n                }`}\n              >\n                <FileCode className=\"w-3.5 h-3.5\" />\n                <span>{tab}</span>\n              </button>\n            ))}\n          </div>\n\n          <button\n            onClick={handleCopy}\n            className=\"px-3 py-1 text-xs font-mono-tech text-[#94a3b8] hover:text-[#00f0ff] flex items-center gap-1 bg-[#0d1322] border border-[#00f0ff]/20 rounded\"\n          >\n            {isCopied ? (\n              <>\n                <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span>Copied!</span>\n              </>\n            ) : (\n              <>\n                <Copy className=\"w-3.5 h-3.5\" />\n                <span>Copy File Code</span>\n              </>\n            )}\n          </button>\n        </div>\n\n        {/* Code Content View */}\n        <div className=\"p-6 flex-1 overflow-y-auto bg-[#07090e] font-mono-tech text-xs leading-relaxed text-[#cbd5e1]\">\n          <pre className=\"overflow-x-auto p-4 rounded-xl bg-[#0a0e17] border border-[#00f0ff]/20\">\n            <code>{codeSnippets[activeTab]}</code>\n          </pre>\n        </div>\n\n        {/* Footer Hint */}\n        <div className=\"px-6 py-3 border-t border-[#00f0ff]/20 bg-[#0a0e17] flex items-center justify-between text-xs font-mono-tech text-[#94a3b8]\">\n          <span>EASILY EDITABLE \302\267 PURE REACT 19 & TAILWIND CSS</span>\n          <span className=\"text-[#00f0ff]\">ZIP CONTAINS FULL STANDALONE PROJECT</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
