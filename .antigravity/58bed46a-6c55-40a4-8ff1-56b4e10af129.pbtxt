    replacement_chunks {
      replacement_content: "import React, { useRef, useEffect, useState, useCallback } from \'react\';\nimport * as THREE from \'three\';\nimport { RotateCw, Play, Pause, Compass, Layers, ZoomIn, ZoomOut, Sparkles, RefreshCw, Eye, ArrowUp, ArrowDown } from \'lucide-react\';\nimport { CAR_HOTSPOTS } from \'../data/mockCarData\';\nimport { CarHotspot } from \'../types\';\n\ninterface Car3DCanvasProps {\n  onSelectHotspot: (hotspot: CarHotspot) => void;\n}\n\n// 3D Hotspot Definition mapped to real 3D Coordinates\ninterface Hotspot3D {\n  id: string;\n  name: string;\n  part: string;\n  position: THREE.Vector3;\n  data: CarHotspot;\n}\n\nconst PAINT_FINISHES = [\n  { name: \'Apex Cobalt\', hex: \'#2563eb\', emissive: \'#0284c7\' },\n  { name: \'Cyber Neon\', hex: \'#00f0ff\', emissive: \'#00c2ff\' },\n  { name: \'Titanium Silver\', hex: \'#e2e8f0\', emissive: \'#94a3b8\' },\n  { name: \'Matte Obsidian\', hex: \'#18181b\', emissive: \'#27272a\' },\n  { name: \'Track Crimson\', hex: \'#dc2626\', emissive: \'#991b1b\' },\n  { name: \'Solar Gold\', hex: \'#f59e0b\', emissive: \'#d97706\' },\n];\n\nexport const Car3DCanvas: React.FC<Car3DCanvasProps> = ({ onSelectHotspot }) => {\n  const mountRef = useRef<HTMLDivElement>(null);\n  const [isAutoRotating, setIsAutoRotating] = useState<boolean>(false);\n  const [wireframeMode, setWireframeMode] = useState<boolean>(false);\n  const [selectedPaint, setSelectedPaint] = useState<string>(\'#2563eb\');\n  const [hotspotScreenPositions, setHotspotScreenPositions] = useState<{ [key: string]: { x: number; y: number; visible: boolean } }>({});\n  const [cameraAzimuth, setCameraAzimuth] = useState<number>(45);\n  const [cameraElevation, setCameraElevation] = useState<number>(20);\n\n  // References to three objects for interaction\n  const sceneRef = useRef<THREE.Scene | null>(null);\n  const cameraRef = useRef<THREE.PerspectiveCamera | null>(null);\n  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);\n  const carGroupRef = useRef<THREE.Group | null>(null);\n  const paintMaterialsRef = useRef<THREE.MeshPhysicalMaterial[]>([]);\n  const allMeshesRef = useRef<THREE.Mesh[]>([]);\n  const animFrameIdRef = useRef<number | null>(null);\n\n  // Orbit state\n  const orbitState = useRef({\n    isDragging: false,\n    prevMouseX: 0,\n    prevMouseY: 0,\n    theta: Math.PI / 4, // Horizontal azimuth angle\n    phi: Math.PI / 3,   // Vertical polar angle\n    radius: 7.5,        // Distance from target\n    target: new THREE.Vector3(0, 0.4, 0),\n    damping: 0.08,\n    targetTheta: Math.PI / 4,\n    targetPhi: Math.PI / 3,\n    targetRadius: 7.5,\n  });\n\n  // Map 3D hotspots to mockCarData\n  const hotspots3D = useRef<Hotspot3D[]>([\n    {\n      id: \'hotspot-hood\',\n      name: \'Autonomous Laser Sensor\',\n      part: \'Front Hood Sensor Pod\',\n      position: new THREE.Vector3(0, 0.75, 1.8),\n      data: CAR_HOTSPOTS[0],\n    },\n    {\n      id: \'hotspot-wheel\',\n      name: \'Carbon-Ceramic Braking & Wheels\',\n      part: \'Right Wheel Assembly\',\n      position: new THREE.Vector3(1.18, 0.45, 1.3),\n      data: CAR_HOTSPOTS[1],\n    },\n    {\n      id: \'hotspot-wing\',\n      name: \'Active Aerodynamic Wing & Dyno\',\n      part: \'Rear Downforce GT Wing\',\n      position: new THREE.Vector3(0, 1.25, -2.1),\n      data: CAR_HOTSPOTS[2],\n    },\n    {\n      id: \'hotspot-diffuser\',\n      name: \'Ground-Effect Venturi Diffuser\',\n      part: \'Sub-Chassis Undercarriage\',\n      position: new THREE.Vector3(0, -0.05, -1.1),\n      data: CAR_HOTSPOTS[3],\n    },\n    {\n      id: \'hotspot-cockpit\',\n      name: \'Holographic HUD & 9H Glass\',\n      part: \'Smart Cockpit Canopy\',\n      position: new THREE.Vector3(0, 0.98, 0.15),\n      data: CAR_HOTSPOTS[4],\n    },\n  ]);\n\n  // Set camera angle preset\n  const setCameraPreset = (thetaDeg: number, phiDeg: number, radius = 7.5) => {\n    setIsAutoRotating(false);\n    orbitState.current.targetTheta = (thetaDeg * Math.PI) / 180;\n    orbitState.current.targetPhi = Math.max(0.1, Math.min(Math.PI - 0.1, (phiDeg * Math.PI) / 180));\n    orbitState.current.targetRadius = radius;\n  };\n\n  // Zoom controls\n  const handleZoom = (delta: number) => {\n    orbitState.current.targetRadius = Math.max(4.2, Math.min(11.0, orbitState.current.targetRadius + delta));\n  };\n\n  useEffect(() => {\n    if (!mountRef.current) return;\n    const container = mountRef.current;\n    const width = container.clientWidth;\n    const height = container.clientHeight;\n\n    // 1. Scene Setup\n    const scene = new THREE.Scene();\n    sceneRef.current = scene;\n\n    // 2. Camera Setup\n    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);\n    cameraRef.current = camera;\n    camera.position.set(5, 3.5, 5);\n\n    // 3. WebGL Renderer\n    const renderer = new THREE.WebGLRenderer({\n      antialias: true,\n      alpha: true,\n      powerPreference: \'high-performance\',\n    });\n    rendererRef.current = renderer;\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.15;\n    container.appendChild(renderer.domElement);\n\n    // 4. Lighting Rig\n    const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);\n    scene.add(ambientLight);\n\n    const mainKeyLight = new THREE.DirectionalLight(0xffffff, 1.8);\n    mainKeyLight.position.set(6, 10, 6);\n    mainKeyLight.castShadow = true;\n    mainKeyLight.shadow.mapSize.width = 2048;\n    mainKeyLight.shadow.mapSize.height = 2048;\n    mainKeyLight.shadow.camera.near = 0.5;\n    mainKeyLight.shadow.camera.far = 25;\n    mainKeyLight.shadow.bias = -0.0005;\n    scene.add(mainKeyLight);\n\n    const cyanRimLight = new THREE.DirectionalLight(0x00f0ff, 1.4);\n    cyanRimLight.position.set(-6, 5, -6);\n    scene.add(cyanRimLight);\n\n    const underGlowLight = new THREE.PointLight(0x00f0ff, 2.5, 6);\n    underGlowLight.position.set(0, -0.3, 0);\n    scene.add(underGlowLight);\n\n    // 5. Turntable Studio Stage Ground\n    const groundGroup = new THREE.Group();\n    scene.add(groundGroup);\n\n    // Subtle dark circular reflection floor\n    const floorGeo = new THREE.CircleGeometry(4.8, 64);\n    const floorMat = new THREE.MeshStandardMaterial({\n      color: 0x0a0f1d,\n      roughness: 0.35,\n      metalness: 0.6,\n    });\n    const floorMesh = new THREE.Mesh(floorGeo, floorMat);\n    floorMesh.rotation.x = -Math.PI / 2;\n    floorMesh.position.y = -0.01;\n    floorMesh.receiveShadow = true;\n    groundGroup.add(floorMesh);\n\n    // Glowing Concentric Laser Turntable Rings\n    const ringGeo1 = new THREE.RingGeometry(4.2, 4.25, 64);\n    const ringMat1 = new THREE.MeshBasicMaterial({ color: 0x00f0ff, side: THREE.DoubleSide });\n    const ringMesh1 = new THREE.Mesh(ringGeo1, ringMat1);\n    ringMesh1.rotation.x = -Math.PI / 2;\n    ringMesh1.position.y = 0.002;\n    groundGroup.add(ringMesh1);\n\n    const ringGeo2 = new THREE.RingGeometry(3.2, 3.23, 64);\n    const ringMat2 = new THREE.MeshBasicMaterial({ color: 0x0284c7, side: THREE.DoubleSide });\n    const ringMesh2 = new THREE.Mesh(ringGeo2, ringMat2);\n    ringMesh2.rotation.x = -Math.PI / 2;\n    ringMesh2.position.y = 0.003;\n    groundGroup.add(ringMesh2);\n\n    // Contact Soft Shadow Disk directly under the chassis\n    const shadowGeo = new THREE.PlaneGeometry(4.4, 2.2);\n    const shadowMat = new THREE.MeshBasicMaterial({\n      color: 0x000000,\n      transparent: true,\n      opacity: 0.75,\n    });\n    const shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);\n    shadowMesh.rotation.x = -Math.PI / 2;\n    shadowMesh.position.set(0, 0.005, 0);\n    groundGroup.add(shadowMesh);\n\n    // 6. Build Procedural 3D Aerodynamic Hypercar Model\n    const carGroup = new THREE.Group();\n    carGroupRef.current = carGroup;\n    scene.add(carGroup);\n\n    // Materials Library\n    const paintMat = new THREE.MeshPhysicalMaterial({\n      color: new THREE.Color(selectedPaint),\n      metalness: 0.88,\n      roughness: 0.18,\n      clearcoat: 1.0,\n      clearcoatRoughness: 0.08,\n      reflectivity: 0.95,\n    });\n    paintMaterialsRef.current = [paintMat];\n\n    const carbonMat = new THREE.MeshStandardMaterial({\n      color: 0x111317,\n      metalness: 0.3,\n      roughness: 0.5,\n    });\n\n    const glassMat = new THREE.MeshPhysicalMaterial({\n      color: 0x0b1329,\n      transmission: 0.8,\n      opacity: 0.9,\n      transparent: true,\n      roughness: 0.05,\n      metalness: 0.1,\n      ior: 1.5,\n    });\n\n    const chromeMat = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      metalness: 0.95,\n      roughness: 0.1,\n    });\n\n    const tireRubberMat = new THREE.MeshStandardMaterial({\n      color: 0x1a1a1e,\n      roughness: 0.85,\n      metalness: 0.1,\n    });\n\n    const brakeCaliperMat = new THREE.MeshStandardMaterial({\n      color: 0x00f0ff,\n      emissive: 0x00c2ff,\n      emissiveIntensity: 0.4,\n      metalness: 0.8,\n      roughness: 0.2,\n    });\n\n    const ledGlowMat = new THREE.MeshBasicMaterial({\n      color: 0x00f0ff,\n    });\n\n    const tailGlowMat = new THREE.MeshBasicMaterial({\n      color: 0xff1744,\n    });\n\n    const collectMesh = (mesh: THREE.Mesh) => {\n      mesh.castShadow = true;\n      mesh.receiveShadow = true;\n      allMeshesRef.current.push(mesh);\n      return mesh;\n    };\n\n    // A. Main Chassis Monocoque Lower Body\n    const bodyBaseGeo = new THREE.BoxGeometry(1.9, 0.38, 4.4, 4, 2, 8);\n    const bodyBase = collectMesh(new THREE.Mesh(bodyBaseGeo, paintMat));\n    bodyBase.position.set(0, 0.42, 0);\n    carGroup.add(bodyBase);\n\n    // B. Aerodynamic Sculpted Front Hood & Nose Cone\n    const hoodGeo = new THREE.CylinderGeometry(0.78, 0.96, 1.4, 16);\n    const hood = collectMesh(new THREE.Mesh(hoodGeo, paintMat));\n    hood.rotation.x = Math.PI / 2;\n    hood.rotation.z = Math.PI / 2;\n    hood.scale.set(0.4, 1.25, 0.9);\n    hood.position.set(0, 0.48, 1.45);\n    carGroup.add(hood);\n\n    // C. Front Carbon Splitter with Dual Winglets\n    const splitterGeo = new THREE.BoxGeometry(2.02, 0.05, 0.7);\n    const splitter = collectMesh(new THREE.Mesh(splitterGeo, carbonMat));\n    splitter.position.set(0, 0.14, 2.18);\n    carGroup.add(splitter);\n\n    // D. Curved Cockpit Bubble Canopy (Windshield + Roof + Rear Engine Glass)\n    const canopyGeo = new THREE.SphereGeometry(1.0, 32, 16, 0, Math.PI * 2, 0, Math.PI / 2);\n    const canopy = collectMesh(new THREE.Mesh(canopyGeo, glassMat));\n    canopy.scale.set(0.82, 0.62, 1.6);\n    canopy.position.set(0, 0.58, -0.05);\n    carGroup.add(canopy);\n\n    // E. Cockpit Roof Carbon Spine & Air Intake Scoop\n    const scoopGeo = new THREE.BoxGeometry(0.3, 0.12, 1.2);\n    const scoop = collectMesh(new THREE.Mesh(scoopGeo, carbonMat));\n    scoop.position.set(0, 1.16, -0.2);\n    carGroup.add(scoop);\n\n    // F. Side Air Pods / Radiator Scoops\n    const leftPodGeo = new THREE.BoxGeometry(0.24, 0.36, 1.8);\n    const leftPod = collectMesh(new THREE.Mesh(leftPodGeo, paintMat));\n    leftPod.position.set(0.98, 0.44, -0.15);\n    carGroup.add(leftPod);\n\n    const rightPod = collectMesh(new THREE.Mesh(leftPodGeo, paintMat));\n    rightPod.position.set(-0.98, 0.44, -0.15);\n    carGroup.add(rightPod);\n\n    // G. Rear GT Downforce Aerodynamic Wing\n    const wingPlaneGeo = new THREE.BoxGeometry(2.1, 0.04, 0.42);\n    const wing = collectMesh(new THREE.Mesh(wingPlaneGeo, carbonMat));\n    wing.position.set(0, 1.18, -2.15);\n    wing.rotation.x = -0.08;\n    carGroup.add(wing);\n\n    // Wing dual vertical endplates\n    const endplateGeo = new THREE.BoxGeometry(0.04, 0.22, 0.48);\n    const leftEndplate = collectMesh(new THREE.Mesh(endplateGeo, carbonMat));\n    leftEndplate.position.set(1.06, 1.18, -2.15);\n    carGroup.add(leftEndplate);\n\n    const rightEndplate = collectMesh(new THREE.Mesh(endplateGeo, carbonMat));\n    rightEndplate.position.set(-1.06, 1.18, -2.15);\n    carGroup.add(rightEndplate);\n\n    // Wing Carbon Pylons\n    const pylonGeo = new THREE.CylinderGeometry(0.03, 0.03, 0.65, 8);\n    const leftPylon = collectMesh(new THREE.Mesh(pylonGeo, carbonMat));\n    leftPylon.position.set(0.48, 0.85, -2.05);\n    leftPylon.rotation.x = 0.22;\n    carGroup.add(leftPylon);\n\n    const rightPylon = collectMesh(new THREE.Mesh(pylonGeo, carbonMat));\n    rightPylon.position.set(-0.48, 0.85, -2.05);\n    rightPylon.rotation.x = 0.22;\n    carGroup.add(rightPylon);\n\n    // H. Rear Venturi Diffuser\n    const diffuserGeo = new THREE.BoxGeometry(1.85, 0.16, 0.65);\n    const diffuser = collectMesh(new THREE.Mesh(diffuserGeo, carbonMat));\n    diffuser.position.set(0, 0.22, -2.15);\n    diffuser.rotation.x = -0.2;\n    carGroup.add(diffuser);\n\n    // Diffuser vertical aerodynamic strakes\n    [-0.5, -0.2, 0.2, 0.5].forEach((xPos) => {\n      const finGeo = new THREE.BoxGeometry(0.03, 0.18, 0.6);\n      const fin = collectMesh(new THREE.Mesh(finGeo, carbonMat));\n      fin.position.set(xPos, 0.2, -2.15);\n      carGroup.add(fin);\n    });\n\n    // I. LED Headlights & Laser Taillights\n    const leftHeadlightGeo = new THREE.BoxGeometry(0.45, 0.05, 0.2);\n    const leftHeadlight = collectMesh(new THREE.Mesh(leftHeadlightGeo, ledGlowMat));\n    leftHeadlight.position.set(0.65, 0.44, 2.14);\n    leftHeadlight.rotation.y = 0.2;\n    carGroup.add(leftHeadlight);\n\n    const rightHeadlight = collectMesh(new THREE.Mesh(leftHeadlightGeo, ledGlowMat));\n    rightHeadlight.position.set(-0.65, 0.44, 2.14);\n    rightHeadlight.rotation.y = -0.2;\n    carGroup.add(rightHeadlight);\n\n    // Rear Laser LED Taillight Bar\n    const taillightGeo = new THREE.BoxGeometry(1.7, 0.04, 0.08);\n    const taillight = collectMesh(new THREE.Mesh(taillightGeo, tailGlowMat));\n    taillight.position.set(0, 0.52, -2.21);\n    carGroup.add(taillight);\n\n    // J. Hood Autonomous Laser Sensor Pod\n    const sensorGeo = new THREE.CylinderGeometry(0.12, 0.14, 0.1, 16);\n    const sensor = collectMesh(new THREE.Mesh(sensorGeo, carbonMat));\n    sensor.position.set(0, 0.66, 1.82);\n    carGroup.add(sensor);\n\n    const sensorLensGeo = new THREE.SphereGeometry(0.08, 16, 16);\n    const sensorLens = collectMesh(new THREE.Mesh(sensorLensGeo, ledGlowMat));\n    sensorLens.position.set(0, 0.72, 1.82);\n    carGroup.add(sensorLens);\n\n    // K. Detailed 4 Wheels (Tires + Rims + Brake Rotors + Calipers)\n    const wheelPositions = [\n      { x: 0.96, z: 1.35, isRight: true },   // Front Right\n      { x: -0.96, z: 1.35, isRight: false }, // Front Left\n      { x: 0.98, z: -1.35, isRight: true },  // Rear Right\n      { x: -0.98, z: -1.35, isRight: false },// Rear Left\n    ];\n\n    wheelPositions.forEach((wp) => {\n      const wheelAssembly = new THREE.Group();\n      wheelAssembly.position.set(wp.x, 0.36, wp.z);\n\n      // Rubber Tire\n      const tireGeo = new THREE.CylinderGeometry(0.36, 0.36, 0.26, 32);\n      const tire = collectMesh(new THREE.Mesh(tireGeo, tireRubberMat));\n      tire.rotation.z = Math.PI / 2;\n      wheelAssembly.add(tire);\n\n      // Forged Alloy Wheel Rim\n      const rimGeo = new THREE.CylinderGeometry(0.26, 0.26, 0.27, 16);\n      const rim = collectMesh(new THREE.Mesh(rimGeo, chromeMat));\n      rim.rotation.z = Math.PI / 2;\n      wheelAssembly.add(rim);\n\n      // Wheel Spokes\n      for (let s = 0; s < 5; s++) {\n        const spokeGeo = new THREE.BoxGeometry(0.03, 0.45, 0.05);\n        const spoke = collectMesh(new THREE.Mesh(spokeGeo, carbonMat));\n        spoke.rotation.x = (s * Math.PI) / 5;\n        spoke.position.x = wp.isRight ? 0.08 : -0.08;\n        wheelAssembly.add(spoke);\n      }\n\n      // Carbon-Ceramic Ventilated Brake Disc\n      const rotorGeo = new THREE.CylinderGeometry(0.22, 0.22, 0.04, 24);\n      const rotor = collectMesh(new THREE.Mesh(rotorGeo, carbonMat));\n      rotor.rotation.z = Math.PI / 2;\n      rotor.position.x = wp.isRight ? -0.04 : 0.04;\n      wheelAssembly.add(rotor);\n\n      // Neon Glowing Brake Caliper\n      const caliperGeo = new THREE.BoxGeometry(0.12, 0.16, 0.08);\n      const caliper = collectMesh(new THREE.Mesh(caliperGeo, brakeCaliperMat));\n      caliper.position.set(wp.isRight ? -0.03 : 0.03, 0.15, 0.1);\n      wheelAssembly.add(caliper);\n\n      carGroup.add(wheelAssembly);\n    });\n\n    // 7. Mouse and Touch Event Handlers\n    const onMouseDown = (e: MouseEvent) => {\n      orbitState.current.isDragging = true;\n      orbitState.current.prevMouseX = e.clientX;\n      orbitState.current.prevMouseY = e.clientY;\n      setIsAutoRotating(false);\n    };\n\n    const onMouseMove = (e: MouseEvent) => {\n      if (!orbitState.current.isDragging) return;\n      const deltaX = e.clientX - orbitState.current.prevMouseX;\n      const deltaY = e.clientY - orbitState.current.prevMouseY;\n\n      orbitState.current.targetTheta -= deltaX * 0.007;\n      orbitState.current.targetPhi = Math.max(\n        0.1,\n        Math.min(Math.PI * 0.88, orbitState.current.targetPhi - deltaY * 0.007)\n      );\n\n      orbitState.current.prevMouseX = e.clientX;\n      orbitState.current.prevMouseY = e.clientY;\n    };\n\n    const onMouseUp = () => {\n      orbitState.current.isDragging = false;\n    };\n\n    const onWheel = (e: WheelEvent) => {\n      e.preventDefault();\n      handleZoom(e.deltaY * 0.004);\n    };\n\n    // Touch Support\n    const onTouchStart = (e: TouchEvent) => {\n      if (e.touches[0]) {\n        orbitState.current.isDragging = true;\n        orbitState.current.prevMouseX = e.touches[0].clientX;\n        orbitState.current.prevMouseY = e.touches[0].clientY;\n        setIsAutoRotating(false);\n      }\n    };\n\n    const onTouchMove = (e: TouchEvent) => {\n      if (!orbitState.current.isDragging || !e.touches[0]) return;\n      const deltaX = e.touches[0].clientX - orbitState.current.prevMouseX;\n      const deltaY = e.touches[0].clientY - orbitState.current.prevMouseY;\n\n      orbitState.current.targetTheta -= deltaX * 0.008;\n      orbitState.current.targetPhi = Math.max(\n        0.1,\n        Math.min(Math.PI * 0.88, orbitState.current.targetPhi - deltaY * 0.008)\n      );\n\n      orbitState.current.prevMouseX = e.touches[0].clientX;\n      orbitState.current.prevMouseY = e.touches[0].clientY;\n    };\n\n    const domElement = renderer.domElement;\n    domElement.addEventListener(\'mousedown\', onMouseDown);\n    window.addEventListener(\'mousemove\', onMouseMove);\n    window.addEventListener(\'mouseup\', onMouseUp);\n    domElement.addEventListener(\'wheel\', onWheel, { passive: false });\n    domElement.addEventListener(\'touchstart\', onTouchStart);\n    window.addEventListener(\'touchmove\', onTouchMove);\n    window.addEventListener(\'touchend\', onMouseUp);\n\n    // 8. Animation & Render Loop\n    const clock = new THREE.Clock();\n\n    const animate = () => {\n      animFrameIdRef.current = requestAnimationFrame(animate);\n\n      // Auto rotation\n      if (isAutoRotating) {\n        orbitState.current.targetTheta += 0.008;\n      }\n\n      // Smooth Orbit Damping\n      const state = orbitState.current;\n      state.theta += (state.targetTheta - state.theta) * state.damping;\n      state.phi += (state.targetPhi - state.phi) * state.damping;\n      state.radius += (state.targetRadius - state.radius) * state.damping;\n\n      // Convert spherical coordinates to camera Cartesian position\n      camera.position.x = state.target.x + state.radius * Math.sin(state.phi) * Math.sin(state.theta);\n      camera.position.y = state.target.y + state.radius * Math.cos(state.phi);\n      camera.position.z = state.target.z + state.radius * Math.sin(state.phi) * Math.cos(state.theta);\n      camera.lookAt(state.target);\n\n      // Subtle underglow pulsating\n      const elapsedTime = clock.getElapsedTime();\n      underGlowLight.intensity = 2.2 + Math.sin(elapsedTime * 3) * 0.6;\n\n      // Update HUD telemetry degrees\n      const azimuthDeg = Math.round(((state.theta * 180) / Math.PI) % 360);\n      const normalizedAzimuth = (azimuthDeg + 360) % 360;\n      const elevationDeg = Math.round(90 - (state.phi * 180) / Math.PI);\n      setCameraAzimuth(normalizedAzimuth);\n      setCameraElevation(elevationDeg);\n\n      // Project 3D Hotspots into 2D Screen Space\n      const newPositions: { [key: string]: { x: number; y: number; visible: boolean } } = {};\n      const containerRect = container.getBoundingClientRect();\n\n      hotspots3D.current.forEach((spot) => {\n        const worldPos = spot.position.clone();\n        carGroup.localToWorld(worldPos);\n\n        // Vector project to NDC (-1 to 1)\n        const screenVec = worldPos.clone().project(camera);\n\n        // Check if point is in front of camera\n        const isBehind = screenVec.z > 1;\n        const x = ((screenVec.x + 1) / 2) * containerRect.width;\n        const y = ((-screenVec.y + 1) / 2) * containerRect.height;\n\n        newPositions[spot.id] = {\n          x,\n          y,\n          visible: !isBehind && x >= 10 && x <= containerRect.width - 10 && y >= 10 && y <= containerRect.height - 10,\n        };\n      });\n\n      setHotspotScreenPositions(newPositions);\n\n      // Render\n      renderer.render(scene, camera);\n    };\n\n    animate();\n\n    // 9. Resize Handling via ResizeObserver\n    const resizeObserver = new ResizeObserver((entries) => {\n      for (const entry of entries) {\n        const { width: newWidth, height: newHeight } = entry.contentRect;\n        if (newWidth > 0 && newHeight > 0) {\n          camera.aspect = newWidth / newHeight;\n          camera.updateProjectionMatrix();\n          renderer.setSize(newWidth, newHeight);\n        }\n      }\n    });\n\n    resizeObserver.observe(container);\n\n    // Cleanup\n    return () => {\n      if (animFrameIdRef.current) cancelAnimationFrame(animFrameIdRef.current);\n      resizeObserver.disconnect();\n\n      domElement.removeEventListener(\'mousedown\', onMouseDown);\n      window.removeEventListener(\'mousemove\', onMouseMove);\n      window.removeEventListener(\'mouseup\', onMouseUp);\n      domElement.removeEventListener(\'wheel\', onWheel);\n      domElement.removeEventListener(\'touchstart\', onTouchStart);\n      window.removeEventListener(\'touchmove\', onTouchMove);\n      window.removeEventListener(\'touchend\', onMouseUp);\n\n      if (container.contains(domElement)) {\n        container.removeChild(domElement);\n      }\n\n      renderer.dispose();\n      scene.clear();\n    };\n  }, [isAutoRotating]);\n\n  // Handle Paint Finish Change\n  const handlePaintSelect = (hex: string) => {\n    setSelectedPaint(hex);\n    paintMaterialsRef.current.forEach((mat) => {\n      mat.color.set(hex);\n      mat.needsUpdate = true;\n    });\n  };\n\n  // Handle Wireframe LiDAR Mode Toggle\n  const toggleWireframe = () => {\n    const next = !wireframeMode;\n    setWireframeMode(next);\n    allMeshesRef.current.forEach((mesh) => {\n      if (Array.isArray(mesh.material)) {\n        mesh.material.forEach((m) => {\n          m.wireframe = next;\n        });\n      } else if (mesh.material) {\n        mesh.material.wireframe = next;\n      }\n    });\n  };\n\n  return (\n    <div className=\"relative w-full h-full flex flex-col\">\n      {/* Top Telemetry HUD in Canvas */}\n      <div className=\"absolute top-4 left-4 right-4 z-20 flex flex-wrap items-center justify-between gap-3 pointer-events-none\">\n        {/* Left Telemetry: Model & Status */}\n        <div className=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--bg-card)]/90 border border-[var(--border-color)] shadow-md backdrop-blur-md pointer-events-auto text-xs font-mono-tech\">\n          <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n          <span className=\"font-bold text-[var(--text-primary)] uppercase\">GK-HYPER-01</span>\n          <span className=\"text-[var(--accent-cyan)] font-semibold\">\302\267 3D WEBGL ENGINE</span>\n        </div>\n\n        {/* Right HUD Controls: Paint, Wireframe, Auto-Rotate, Zoom */}\n        <div className=\"flex items-center gap-2 pointer-events-auto\">\n          {/* Wireframe Mode */}\n          <button\n            id=\"toggle-3d-wireframe-btn\"\n            onClick={toggleWireframe}\n            className={`px-3 py-1.5 rounded-xl border text-xs font-mono-tech transition-all flex items-center gap-1.5 cursor-pointer backdrop-blur-md ${\n              wireframeMode\n                ? \'bg-[var(--accent-cyan)] text-white border-[var(--accent-cyan)] shadow-[0_0_15px_var(--accent-glow)]\'\n                : \'bg-[var(--bg-card)]/90 text-[var(--text-secondary)] border-[var(--border-color)] hover:text-[var(--accent-cyan)]\'\n            }`}\n            title=\"Toggle Real-Time LiDAR Wireframe Scan\"\n          >\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span className=\"hidden sm:inline\">LiDAR Scan</span>\n          </button>\n\n          {/* Auto-Rotate Toggle */}\n          <button\n            id=\"toggle-3d-autorotate-btn\"\n            onClick={() => setIsAutoRotating(!isAutoRotating)}\n            className=\"gk-btn text-xs py-1.5 px-3 flex items-center gap-1.5 cursor-pointer backdrop-blur-md\"\n          >\n            {isAutoRotating ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n            <span className=\"hidden sm:inline\">{isAutoRotating ? \'Pause Orbit\' : \'Auto Orbit\'}</span>\n          </button>\n\n          {/* Zoom In / Out */}\n          <div className=\"flex items-center bg-[var(--bg-card)]/90 border border-[var(--border-color)] rounded-xl overflow-hidden backdrop-blur-md shadow-sm\">\n            <button\n              onClick={() => handleZoom(0.8)}\n              className=\"p-1.5 text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 transition-colors cursor-pointer\"\n              title=\"Zoom Out\"\n            >\n              <ZoomOut className=\"w-3.5 h-3.5\" />\n            </button>\n            <div className=\"w-[1px] h-4 bg-[var(--border-color)]\" />\n            <button\n              onClick={() => handleZoom(-0.8)}\n              className=\"p-1.5 text-[var(--text-secondary)] hover:text-[var(--accent-cyan)] hover:bg-[var(--accent-cyan)]/10 transition-colors cursor-pointer\"\n              title=\"Zoom In\"\n            >\n              <ZoomIn className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* 3D WebGL Canvas Container */}\n      <div\n        ref={mountRef}\n        id=\"webgl-car-canvas-mount\"\n        className=\"relative w-full h-[480px] sm:h-[560px] md:h-[620px] cursor-grab active:cursor-grabbing select-none\"\n      >\n        {/* Floating 3D Interactive Hotspot Markers Projected Over the 3D Car */}\n        {hotspots3D.current.map((spot) => {\n          const pos = hotspotScreenPositions[spot.id];\n          if (!pos || !pos.visible) return null;\n\n          return (\n            <button\n              key={spot.id}\n              id={`3d-hotspot-${spot.id}`}\n              onClick={(e) => {\n                e.stopPropagation();\n                onSelectHotspot(spot.data);\n              }}\n              style={{\n                left: `${pos.x}px`,\n                top: `${pos.y}px`,\n              }}\n              className=\"absolute z-30 -translate-x-1/2 -translate-y-1/2 group cursor-pointer animate-fadeIn\"\n            >\n              {/* Pulsing 3D Ring */}\n              <div className=\"relative flex items-center justify-center\">\n                <span className=\"absolute w-8 h-8 rounded-full bg-[var(--accent-cyan)]/30 animate-ping pointer-events-none\" />\n                <span className=\"w-6 h-6 rounded-full bg-[var(--bg-card)] border-2 border-[var(--accent-cyan)] flex items-center justify-center shadow-[0_0_20px_var(--accent-cyan)] group-hover:scale-125 transition-transform\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-[var(--accent-cyan)]\" />\n                </span>\n              </div>\n\n              {/* Tooltip on Hover */}\n              <div className=\"absolute left-1/2 -top-16 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none z-40 whitespace-nowrap\">\n                <div className=\"px-3 py-1.5 rounded-lg bg-[var(--bg-card)] border border-[var(--accent-cyan)] text-left shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-md\">\n                  <div className=\"text-[10px] font-mono-tech text-[var(--accent-cyan)] uppercase font-semibold\">\n                    INSPECT 3D TELEMETRY \302\267 {spot.part}\n                  </div>\n                  <div className=\"text-xs font-primary font-bold text-[var(--text-primary)]\">\n                    {spot.name}\n                  </div>\n                  <div className=\"flex items-center gap-2 text-[10px] font-mono-tech pt-0.5\">\n                    <span className=\"text-rose-400\">Before: {spot.data.before.conditionScore}%</span>\n                    <span className=\"text-[var(--text-secondary)]\">\342\206\222</span>\n                    <span className=\"text-emerald-400\">After: {spot.data.after.conditionScore}%</span>\n                  </div>\n                </div>\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Floating Bottom Bar: Live 3D Angle Indicator + Paint Finish Swatches + Quick Angle Jumpers */}\n      <div className=\"absolute bottom-4 left-4 right-4 z-20 flex flex-wrap items-center justify-between gap-3 pointer-events-none\">\n        {/* Azimuth & Pitch Telemetry */}\n        <div className=\"flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--bg-card)]/90 border border-[var(--border-color)] shadow-md backdrop-blur-md pointer-events-auto text-xs font-mono-tech text-[var(--text-secondary)]\">\n          <Compass className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n          <span>\n            AZIMUTH: <strong className=\"text-[var(--accent-cyan)]\">{cameraAzimuth}\302\260</strong> \302\267 ELEVATION: <strong className=\"text-[var(--accent-cyan)]\">{cameraElevation}\302\260</strong>\n          </span>\n        </div>\n\n        {/* Paint Customizer Swatches */}\n        <div className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[var(--bg-card)]/90 border border-[var(--border-color)] shadow-md backdrop-blur-md pointer-events-auto\">\n          <span className=\"text-[10px] font-mono-tech uppercase text-[var(--text-muted)] mr-1 hidden sm:inline\">\n            Finish:\n          </span>\n          {PAINT_FINISHES.map((paint) => (\n            <button\n              key={paint.hex}\n              onClick={() => handlePaintSelect(paint.hex)}\n              className={`w-5 h-5 rounded-full transition-transform cursor-pointer border ${\n                selectedPaint === paint.hex\n                  ? \'scale-125 border-[var(--accent-cyan)] shadow-[0_0_10px_var(--accent-cyan)]\'\n                  : \'border-white/20 hover:scale-110\'\n              }`}\n              style={{ backgroundColor: paint.hex }}\n              title={paint.name}\n            />\n          ))}\n        </div>\n      </div>\n\n      {/* Sub-bar: 3D Camera Preset Angles */}\n      <div className=\"p-4 sm:p-5 border-t border-[var(--border-color)] bg-[var(--bg-card-subtle)] flex flex-wrap items-center justify-between gap-3\">\n        <div className=\"flex items-center gap-2 text-xs font-mono-tech text-[var(--text-secondary)]\">\n          <Eye className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n          <span>QUICK 3D CAMERAS:</span>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-1.5 sm:gap-2\">\n          <button\n            onClick={() => setCameraPreset(0, 75)}\n            className=\"px-3 py-1 rounded-lg text-xs font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer\"\n          >\n            0\302\260 Front\n          </button>\n          <button\n            onClick={() => setCameraPreset(45, 68)}\n            className=\"px-3 py-1 rounded-lg text-xs font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer\"\n          >\n            45\302\260 Quarter\n          </button>\n          <button\n            onClick={() => setCameraPreset(90, 75)}\n            className=\"px-3 py-1 rounded-lg text-xs font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer\"\n          >\n            90\302\260 Profile\n          </button>\n          <button\n            onClick={() => setCameraPreset(180, 75)}\n            className=\"px-3 py-1 rounded-lg text-xs font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer\"\n          >\n            180\302\260 Rear\n          </button>\n          <button\n            onClick={() => setCameraPreset(0, 15, 6.5)}\n            className=\"px-3 py-1 rounded-lg text-xs font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer flex items-center gap-1\"\n          >\n            <ArrowUp className=\"w-3 h-3\" />\n            <span>Over Aerial</span>\n          </button>\n          <button\n            onClick={() => setCameraPreset(0, 140, 6.5)}\n            className=\"px-3 py-1 rounded-lg text-xs font-mono-tech uppercase bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)] transition-colors cursor-pointer flex items-center gap-1\"\n          >\n            <ArrowDown className=\"w-3 h-3\" />\n            <span>Under Chassis</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
