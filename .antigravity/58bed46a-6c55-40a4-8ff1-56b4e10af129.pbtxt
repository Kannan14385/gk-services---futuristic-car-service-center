           <div className=\\\"flex items-center gap-4 text-xs font-mono-tech text-[#94a3b8]\\\">\\n                <span>WARRANTY: <strong className=\\\"text-white\\\">{hotspot.warranty}</strong></span>\\n                <span>TIME: <strong className=\\\"text-white\\\">{hotspot.estimatedEnhancementTime}</strong></span>\\n              </div>\\n            </div>\\n            <p className=\\\"text-xs text-[#94a3b8] leading-relaxed\\\">\\n              <strong className=\\\"text-[#e2e8f0]\\\">Technician Laboratory Log: </strong>\\n              {hotspot.techNotes}\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Modal Footer CTA */}\\n        <div className=\\\"px-5 py-4 border-t border-[#00f0ff]/20 bg-[#07090e] flex flex-col sm:flex-row items-center justify-between gap-3\\\">\\n          <div className=\\\"text-xs font-mono-tech text-[#94a3b8]\\\">\\n            RECOMMENDED PROTOCOL: <span className=\\\"text-[#00f0ff] font-semibold\\\">{hotspot.serviceName}</span>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-3 w-full sm:w-auto\\\">\\n            <button\\n              onClick={onClose}\\n              className=\\\"w-1/2 sm:w-auto px-4 py-2 text-xs font-mono-tech text-[#94a3b8] hover:text-white transition-colors\\\"\\n            >\\n              Close Telemetry\\n            </button>\\n            <button\\n              id=\\\"book-enhancement-service-btn\\\"\\n              onClick={() => {\\n                onBookService(hotspot.serviceName);\\n                onClose();\\n              }}\\n              className=\\\"gk-btn w-1/2 sm:w-auto text-xs py-2 px-5\\\"\\n            >\\n              <span>Schedule Enhancement</span>\\n              <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/BeforeAfterModal.tsx\", \"toolAction\":\"Creating BeforeAfterModal.tsx\", \"toolSummary\":\"Create BeforeAfterModal.tsx\"}"
