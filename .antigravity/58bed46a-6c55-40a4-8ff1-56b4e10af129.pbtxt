<h2 className=\"gk-font-h2 font-orbitron font-black tracking-tight text-white\">\n              CORE ENGINEERING & <span className=\"text-[#00f0ff]\">DIAGNOSTICS</span>\n            </h2>\n            <p className=\"mt-2 text-sm sm:text-base text-[#94a3b8] max-w-2xl font-rajdhani font-medium tracking-wide\">\n              Every procedure executed at GK Services follows strict aerospace tolerances. Discover our 6 foundational maintenance pillars calibrated to eliminate mechanical failure.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs font-mono-tech text-[#94a3b8]\">\n              ALL PROTOCOLS BACKED BY GK ZERO-TOLERANCE GUARANTEE\n            </span>\n          </div>\n        </div>\n\n        {/* 6 Service Cards with y-axis -30px Hover Lift (Requirement 8) */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {SERVICE_PILLARS.map((service, index) => (\n            <div\n              key={service.id}\n              id={`service-card-${service.id}`}\n              className=\"gk-hover-lift group relative rounded-2xl bg-[#0d1322]/90 border border-[#00f0ff]/20 p-6 flex flex-col justify-between overflow-hidden shadow-[0_15px_35px_rgba(0,0,0,0.6)]\"\n            >\n              {/* Corner Sci-Fi Tech Accent */}\n              <div className=\"absolute top-0 right-0 w-12 h-12 overflow-hidden pointer-events-none\">\n                <div className=\"absolute transform rotate-45 bg-[#00f0ff]/20 text-[9px] font-mono-tech text-[#00f0ff] text-center w-20 top-2 -right-6 py-0.5 border-b border-[#00f0ff]/40\">\n                  {service.code}\n                </div>\n              </div>\n\n              <div>\n                {/* Header with Icon & Accuracy Badge */}\n                <div className=\"flex items-center justify-between mb-4\">\n                  <div className=\"p-3 rounded-xl bg-[#07090e] border border-[#00f0ff]/30 shadow-[0_0_15px_rgba(0,240,255,0.2)] group-hover:scale-110 group-hover:border-[#00f0ff] transition-all duration-300\">\n                    {getIcon(service.iconName)}\n                  </div>\n\n                  <div className=\"text-right\">\n                    <span className=\"text-[10px] font-mono-tech text-[#94a3b8] uppercase block\">\n                      TOLERANCE\n                    </span>\n                    <span className=\"text-xs font-mono-tech text-[#00f0ff] font-bold\">\n                      {service.accuracy}\n                    </span>\n                  </div>\n                </div>\n\n                <h3 className=\"font-orbitron font-bold text-lg text-white group-hover:text-[#00f0ff] transition-colors\">\n                  {service.title}\n                </h3>\n                <p className=\"text-xs font-mono-tech text-[#38bdf8] mt-1 mb-3\">\n                  {service.subtitle}\n                </p>\n\n                <p className=\"text-xs text-[#cbd5e1] leading-relaxed mb-5\">\n                  {service.description}\n                </p>\n\n                {/* Specs List */}\n                <div className=\"space-y-2 py-3 border-y border-[#00f0ff]/15\">\n                  {service.specs.map((spec, i) => (\n                    <div key={i} className=\"flex items-center gap-2 text-xs font-mono-tech text-[#94a3b8]\">\n                      <div className=\"w-1.5 h-1.5 rounded-full bg-[#00f0ff]\" />\n                      <span>{spec}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Card Footer with Price, Turnaround & Universal Button (Requirement 5) */}\n              <div className=\"mt-6 pt-3 flex items-center justify-between\">\n                <div>\n                  <span className=\"text-[10px] font-mono-tech text-[#94a3b8] uppercase block\">\n                    INVESTMENT\n                  </span>\n                  <div className=\"flex items-baseline gap-1\">\n                    <span className=\"font-orbitron font-bold text-lg text-white\">\n                      {service.priceStarting}\n                    </span>\n                    <span className=\"text-[10px] font-mono-tech text-[#94a3b8]\">\n                      / {service.turnaround}\n                    </span>\n                  </div>\n                </div>\n\n                <button\n                  id={`book-service-${service.id}`}\n                  onClick={() => onBookService(service.title)}\n                  className=\"gk-btn text-xs py-2 px-4\"\n                >\n                  <span>Book Protocol</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
