    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Menu, X, Shield, Radio, Sparkles, Code2, Download } from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenContact: () => void;\n  onOpenCodeZip: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ onOpenContact, onOpenCodeZip }) => {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [activeSection, setActiveSection] = useState(\'hero\');\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 20);\n\n      // Simple active link detection\n      const sections = [\'hero\', \'inspection360\', \'services\', \'technology\', \'calculator\', \'reviews\'];\n      const scrollPos = window.scrollY + 200;\n\n      for (const section of sections) {\n        const el = document.getElementById(section);\n        if (el) {\n          const top = el.offsetTop;\n          const height = el.offsetHeight;\n          if (scrollPos >= top && scrollPos < top + height) {\n            setActiveSection(section);\n            break;\n          }\n        }\n      }\n    };\n\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { label: \'Mission Hub\', href: \'#hero\', id: \'hero\' },\n    { label: \'360\302\260 Car Scan\', href: \'#inspection360\', id: \'inspection360\', badge: \'Interactive\' },\n    { label: \'Services Matrix\', href: \'#services\', id: \'services\' },\n    { label: \'Robotic Bays\', href: \'#technology\', id: \'technology\' },\n    { label: \'Cost Terminal\', href: \'#calculator\', id: \'calculator\' },\n    { label: \'Reviews & FAQ\', href: \'#reviews\', id: \'reviews\' },\n  ];\n\n  const handleNavClick = (href: string) => {\n    setMobileMenuOpen(false);\n    const element = document.querySelector(href);\n    if (element) {\n      element.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      id=\"main-header\"\n      className={`sticky top-0 z-50 w-full transition-all duration-300 ${\n        isScrolled\n          ? \'bg-[#07090e]/90 backdrop-blur-xl border-b border-[#00f0ff]/20 shadow-[0_10px_30px_rgba(0,0,0,0.8)]\'\n          : \'bg-gradient-to-b from-[#07090e] via-[#07090e]/80 to-transparent border-b border-transparent\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n        {/* Division 1: Logo Gk */}\n        <div id=\"header-logo-division\" className=\"flex items-center gap-3\">\n          <a\n            href=\"#hero\"\n            onClick={(e) => {\n              e.preventDefault();\n              handleNavClick(\'#hero\');\n            }}\n            className=\"group flex items-center gap-3 cursor-pointer\"\n          >\n            {/* Futuristic GK Hex Icon */}\n            <div className=\"relative w-11 h-11 flex items-center justify-center bg-[#0d1322] border border-[#00f0ff]/50 rounded-lg overflow-hidden group-hover:border-[#00f0ff] group-hover:shadow-[0_0_20px_rgba(0,240,255,0.6)] transition-all duration-300\">\n              <div className=\"absolute inset-0 bg-gradient-to-br from-[#00f0ff]/20 to-transparent opacity-60 group-hover:opacity-100 transition-opacity\" />\n              <span className=\"font-orbitron font-black text-xl tracking-tighter text-[#00f0ff] group-hover:scale-110 transition-transform\">\n                GK\n              </span>\n              <div className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-[#00f0ff]\" />\n            </div>\n\n            <div className=\"flex flex-col\">\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"font-orbitron font-extrabold text-lg sm:text-xl tracking-wider text-white\">\n                  GK <span className=\"text-[#00f0ff]\">SERVICES</span>\n                </span>\n                <span className=\"hidden sm:inline-block px-1.5 py-0.5 text-[9px] font-mono-tech uppercase bg-[#00f0ff]/10 text-[#00f0ff] border border-[#00f0ff]/30 rounded\">\n                  v3.2.0\n                </span>\n              </div>\n              <span className=\"text-[10px] font-mono-tech tracking-widest text-[#94a3b8] uppercase\">\n                Autonomous Precision Bay\n              </span>\n            </div>\n          </a>\n        </div>\n\n        {/* Division 2: Navigation Menu (Desktop view > 1024px) */}\n        <nav\n          id=\"header-nav-division\"\n          className=\"hidden lg:flex items-center gap-1 xl:gap-2 px-3 py-1.5 bg-[#0d1322]/80 border border-[#00f0ff]/15 rounded-full backdrop-blur-md\"\n        >\n          {navLinks.map((link) => {\n            const isActive = activeSection === link.id;\n            return (\n              <a\n                key={link.id}\n                id={`nav-link-${link.id}`}\n                href={link.href}\n                onClick={(e) => {\n                  e.preventDefault();\n                  handleNavClick(link.href);\n                }}\n                className={`relative px-3 py-1.5 rounded-full text-xs xl:text-sm font-medium transition-all duration-300 flex items-center gap-1.5 ${\n                  isActive\n                    ? \'text-[#07090e] bg-[#00f0ff] font-semibold shadow-[0_0_15px_rgba(0,240,255,0.7)]\'\n                    : \'text-[#94a3b8] hover:text-[#00f0ff] hover:bg-[#00f0ff]/10\'\n                }`}\n              >\n                <span>{link.label}</span>\n                {link.badge && !isActive && (\n                  <span className=\"relative flex h-2 w-2\">\n                    <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00f0ff] opacity-75\"></span>\n                    <span className=\"relative inline-flex rounded-full h-2 w-2 bg-[#00f0ff]\"></span>\n                  </span>\n                )}\n              </a>\n            );\n          })}\n        </nav>\n\n        {/* Division 3: Universal Contact Button + Code/ZIP Export + Hamburger Menu */}\n        <div id=\"header-contact-division\" className=\"flex items-center gap-3\">\n          {/* Quick ZIP / Code Preview button */}\n          <button\n            id=\"header-code-zip-btn\"\n            onClick={onOpenCodeZip}\n            className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono-tech uppercase text-[#94a3b8] hover:text-[#00f0ff] bg-[#0d1322] border border-[#94a3b8]/20 hover:border-[#00f0ff]/40 rounded-md transition-all duration-200\"\n            title=\"Preview Code & Download Project ZIP\"\n          >\n            <Download className=\"w-3.5 h-3.5 text-[#00f0ff]\" />\n            <span>Export ZIP</span>\n          </button>\n\n          {/* Universal Contact Button with Glowing Hover (Requirement 5) */}\n          <button\n            id=\"header-contact-btn\"\n            onClick={onOpenContact}\n            className=\"gk-btn group text-xs sm:text-sm py-2 sm:py-2.5 px-4 sm:px-6\"\n          >\n            <Radio className=\"w-3.5 h-3.5 animate-pulse text-[#00f0ff] group-hover:text-[#07090e] transition-colors\" />\n            <span>Connect Bay</span>\n          </button>\n\n          {/* Mobile / Tablet Hamburger Toggle (Requirement 9: turns to hamburger menu in tab and mobile view) */}\n          <button\n            id=\"header-hamburger-toggle\"\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"lg:hidden p-2 rounded-lg bg-[#0d1322] border border-[#00f0ff]/30 text-[#00f0ff] hover:bg-[#00f0ff]/10 focus:outline-none focus:ring-2 focus:ring-[#00f0ff]\"\n            aria-label=\"Toggle Navigation Menu\"\n          >\n            {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile & Tablet Drawer (Requirement 9) */}\n      {mobileMenuOpen && (\n        <div\n          id=\"mobile-drawer-menu\"\n          className=\"lg:hidden bg-[#07090e]/95 backdrop-blur-2xl border-b border-[#00f0ff]/30 px-6 py-6 transition-all duration-300 shadow-2xl\"\n        >\n          <div className=\"flex flex-col gap-2 pb-4 border-b border-[#00f0ff]/20\">\n            <div className=\"flex items-center justify-between pb-2\">\n              <span className=\"text-xs font-mono-tech text-[#00f0ff] tracking-widest uppercase\">\n                TELEMETRY NAVIGATION\n              </span>\n              <span className=\"flex items-center gap-1 text-[11px] font-mono-tech text-emerald-400\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping\"></span>\n                SYSTEMS OPERATIONAL\n              </span>\n            </div>\n\n            {navLinks.map((link) => {\n              const isActive = activeSection === link.id;\n              return (\n                <a\n                  key={link.id}\n                  id={`mobile-nav-${link.id}`}\n                  href={link.href}\n                  onClick={(e) => {\n                    e.preventDefault();\n                    handleNavClick(link.href);\n                  }}\n                  className={`flex items-center justify-between px-4 py-3 rounded-lg text-sm font-medium transition-all ${\n                    isActive\n                      ? \'bg-[#00f0ff] text-[#07090e] font-semibold shadow-[0_0_15px_rgba(0,240,255,0.4)]\'\n                      : \'text-[#e2e8f0] hover:text-[#00f0ff] hover:bg-[#0d1322]\'\n                  }`}\n                >\n                  <span className=\"font-rajdhani text-base tracking-wide uppercase\">{link.label}</span>\n                  {link.badge && (\n                    <span className=\"text-[10px] font-mono-tech uppercase bg-[#00f0ff]/20 text-[#00f0ff] px-2 py-0.5 rounded border border-[#00f0ff]/30\">\n                      {link.badge}\n                    </span>\n                  )}\n                </a>\n              );\n            })}\n          </div>\n\n          <div className=\"pt-4 flex flex-col gap-3\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenCodeZip();\n              }}\n              className=\"w-full flex items-center justify-center gap-2 py-2.5 px-4 bg-[#0d1322] border border-[#00f0ff]/30 text-xs font-mono-tech text-[#00f0ff] rounded-lg hover:bg-[#00f0ff]/10\"\n            >\n              <Code2 className=\"w-4 h-4\" />\n              <span>Inspect Source & Download ZIP</span>\n            </button>\n\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenContact();\n              }}\n              className=\"gk-btn w-full justify-center text-sm py-3\"\n            >\n              <Radio className=\"w-4 h-4\" />\n              <span>Book Priority Service Dock</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
