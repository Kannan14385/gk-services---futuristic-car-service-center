  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "@layer base {\n  :root {\n    --font-primary: \'Chakra Petch\', \'Michroma\', system-ui, sans-serif;\n    --font-secondary: \'Rajdhani\', system-ui, sans-serif;\n    --font-body: \'Inter\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n\n    /* Light Mode Variables (Entirely opposite & fully compatible with dark) */\n    --bg-primary: #f8fafc;\n    --bg-secondary: #f1f5f9;\n    --bg-card: #ffffff;\n    --bg-card-subtle: #f8fafc;\n    --bg-card-overlay: rgba(255, 255, 255, 0.85);\n    --text-primary: #090d16;\n    --text-secondary: #475569;\n    --text-muted: #64748b;\n    --border-color: rgba(2, 132, 199, 0.22);\n    --border-highlight: rgba(2, 132, 199, 0.55);\n    --accent-cyan: #0284c7;\n    --accent-cyan-light: #0369a1;\n    --accent-glow: rgba(2, 132, 199, 0.25);\n    --grid-line: rgba(2, 132, 199, 0.08);\n  }\n\n  html.dark {\n    /* Dark Mode Variables (Cyberpunk / Void Titanium) */\n    --bg-primary: #07090e;\n    --bg-secondary: #0a0e17;\n    --bg-card: #0d1322;\n    --bg-card-subtle: #090e18;\n    --bg-card-overlay: rgba(13, 19, 34, 0.85);\n    --text-primary: #f8fafc;\n    --text-secondary: #cbd5e1;\n    --text-muted: #94a3b8;\n    --border-color: rgba(0, 240, 255, 0.22);\n    --border-highlight: rgba(0, 240, 255, 0.55);\n    --accent-cyan: #00f0ff;\n    --accent-cyan-light: #38bdf8;\n    --accent-glow: rgba(0, 240, 255, 0.45);\n    --grid-line: rgba(0, 240, 255, 0.04);\n  }\n\n  body {\n    font-family: var(--font-body);\n    background-color: var(--bg-primary);\n    color: var(--text-primary);\n    overflow-x: hidden;\n    transition: background-color 0.3s ease, color 0.3s ease;\n  }\n\n  /* Responsive Font Sizing Rules according to prompt specs */\n  /* Mobile (<768px) */\n  @media (max-width: 767px) {\n    .gk-font-display { font-size: 2rem; line-height: 1.2; }\n    .gk-font-h2 { font-size: 1.6rem; line-height: 1.25; }\n    .gk-font-h3 { font-size: 1.25rem; line-height: 1.3; }\n    .gk-font-body { font-size: 0.9375rem; line-height: 1.5; }\n    .gk-font-sub { font-size: 0.8125rem; }\n  }\n\n  /* Tablet (768px - 1024px) */\n  @media (min-width: 768px) and (max-width: 1024px) {\n    .gk-font-display { font-size: 2.75rem; line-height: 1.15; }\n    .gk-font-h2 { font-size: 2.1rem; line-height: 1.2; }\n    .gk-font-h3 { font-size: 1.45rem; line-height: 1.3; }\n    .gk-font-body { font-size: 1rem; line-height: 1.55; }\n    .gk-font-sub { font-size: 0.875rem; }\n  }\n\n  /* Desktop (>1024px and >1200px) */\n  @media (min-width: 1025px) {\n    .gk-font-display { font-size: 3.5rem; line-height: 1.1; }\n    .gk-font-h2 { font-size: 2.5rem; line-height: 1.2; }\n    .gk-font-h3 { font-size: 1.65rem; line-height: 1.3; }\n    .gk-font-body { font-size: 1.0625rem; line-height: 1.6; }\n    .gk-font-sub { font-size: 0.9375rem; }\n  }\n\n  @media (min-width: 1201px) {\n    .gk-font-display { font-size: 4rem; line-height: 1.08; }\n    .gk-font-h2 { font-size: 2.85rem; line-height: 1.15; }\n  }\n}"
      replacement_content: "@layer base {\n  :root {\n    /* LIGHT MODE: Distinct High-End Aerospace Studio Font & Color Palette */\n    --font-primary: \'Space Grotesk\', \'Plus Jakarta Sans\', system-ui, sans-serif;\n    --font-secondary: \'Plus Jakarta Sans\', system-ui, sans-serif;\n    --font-body: \'Plus Jakarta Sans\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n\n    /* Light Mode Variables (Crisp Racing Titanium & Electric Cobalt) */\n    --bg-primary: #f3f6fa;\n    --bg-secondary: #e8edf5;\n    --bg-card: #ffffff;\n    --bg-card-subtle: #edf2f9;\n    --bg-card-overlay: rgba(255, 255, 255, 0.94);\n    --text-primary: #090e1c;\n    --text-secondary: #334155;\n    --text-muted: #64748b;\n    --border-color: rgba(37, 99, 235, 0.16);\n    --border-highlight: rgba(37, 99, 235, 0.55);\n    --accent-cyan: #1d4ed8;\n    --accent-cyan-light: #2563eb;\n    --accent-glow: rgba(37, 99, 235, 0.28);\n    --grid-line: rgba(37, 99, 235, 0.05);\n  }\n\n  html.dark {\n    /* DARK MODE: Cyberpunk Void Titanium & Neon Cyan (User confirmed \"now dark is okay\") */\n    --font-primary: \'Chakra Petch\', \'Michroma\', system-ui, sans-serif;\n    --font-secondary: \'Rajdhani\', system-ui, sans-serif;\n    --font-body: \'Inter\', system-ui, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n\n    --bg-primary: #07090e;\n    --bg-secondary: #0a0e17;\n    --bg-card: #0d1322;\n    --bg-card-subtle: #090e18;\n    --bg-card-overlay: rgba(13, 19, 34, 0.85);\n    --text-primary: #f8fafc;\n    --text-secondary: #cbd5e1;\n    --text-muted: #94a3b8;\n    --border-color: rgba(0, 240, 255, 0.22);\n    --border-highlight: rgba(0, 240, 255, 0.55);\n    --accent-cyan: #00f0ff;\n    --accent-cyan-light: #38bdf8;\n    --accent-glow: rgba(0, 240, 255, 0.45);\n    --grid-line: rgba(0, 240, 255, 0.04);\n  }\n\n  body {\n    font-family: var(--font-body);\n    background-color: var(--bg-primary);\n    color: var(--text-primary);\n    overflow-x: hidden;\n    transition: background-color 0.3s ease, color 0.3s ease;\n  }\n\n  /* Responsive Font Sizing Rules across screen breakpoints */\n  /* Mobile (<768px) */\n  @media (max-width: 767px) {\n    .gk-font-display { font-size: clamp(1.75rem, 6.5vw, 2.35rem); line-height: 1.15; letter-spacing: -0.02em; }\n    .gk-font-h2 { font-size: clamp(1.35rem, 5vw, 1.75rem); line-height: 1.22; letter-spacing: -0.01em; }\n    .gk-font-h3 { font-size: clamp(1.1rem, 3.8vw, 1.25rem); line-height: 1.3; }\n    .gk-font-body { font-size: 0.875rem; line-height: 1.5; }\n    .gk-font-sub { font-size: 0.75rem; line-height: 1.4; }\n  }\n\n  /* Tablet (768px - 1024px) */\n  @media (min-width: 768px) and (max-width: 1024px) {\n    .gk-font-display { font-size: clamp(2.35rem, 4.5vw, 3rem); line-height: 1.12; }\n    .gk-font-h2 { font-size: clamp(1.85rem, 3.5vw, 2.3rem); line-height: 1.18; }\n    .gk-font-h3 { font-size: 1.35rem; line-height: 1.28; }\n    .gk-font-body { font-size: 0.9375rem; line-height: 1.55; }\n    .gk-font-sub { font-size: 0.8125rem; }\n  }\n\n  /* Desktop (>1024px and >1200px) */\n  @media (min-width: 1025px) {\n    .gk-font-display { font-size: 3.5rem; line-height: 1.08; }\n    .gk-font-h2 { font-size: 2.5rem; line-height: 1.15; }\n    .gk-font-h3 { font-size: 1.6rem; line-height: 1.25; }\n    .gk-font-body { font-size: 1rem; line-height: 1.6; }\n    .gk-font-sub { font-size: 0.875rem; }\n  }\n\n  @media (min-width: 1201px) {\n    .gk-font-display { font-size: 4rem; line-height: 1.06; }\n    .gk-font-h2 { font-size: 2.85rem; line-height: 1.12; }\n  }\n}"
