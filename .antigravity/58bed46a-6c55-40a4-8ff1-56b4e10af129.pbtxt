      target_content: "        {/* Primary Engine Switcher: Interactive 3D WebGL Model vs Multi-Elevation Telemetry */}\n        <div className=\"flex flex-wrap items-center justify-center gap-3 mb-6\">\n          <button\n            id=\"engine-3d-btn\"\n            onClick={() => setDisplayEngine(\'3d\')}\n            className={`px-5 py-2.5 rounded-xl text-xs sm:text-sm font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n              displayEngine === \'3d\'\n                ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_30px_var(--accent-glow)] scale-105\'\n                : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n            }`}\n          >\n            <Box className=\"w-4 h-4 text-emerald-300\" />\n            <span>Interactive 3D WebGL Model</span>\n            <span className=\"px-1.5 py-0.5 rounded text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n              Live WebGL\n            </span>\n          </button>\n\n          <button\n            id=\"engine-multiaxis-btn\"\n            onClick={() => setDisplayEngine(\'multiAxis\')}\n            className={`px-5 py-2.5 rounded-xl text-xs sm:text-sm font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n              displayEngine === \'multiAxis\'\n                ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_30px_var(--accent-glow)] scale-105\'\n                : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n            }`}\n          >\n            <RotateCw className=\"w-4 h-4\" />\n            <span>Multi-Elevation 2D Studio</span>\n          </button>\n        </div>\n\n        {/* If Multi-Axis 2D is chosen, show perspective buttons (Over / Orbit / Under) */}\n        {displayEngine === \'multiAxis\' && (\n          <div className=\"flex flex-wrap items-center justify-center gap-2 sm:gap-4 mb-6 animate-fadeIn\">\n            <button\n              id=\"view-over-btn\"\n              onClick={() => {\n                setElevation(\'over\');\n                setIsAutoRotating(false);\n              }}\n              className={`px-4 py-2 rounded-xl text-xs font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n                elevation === \'over\'\n                  ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_20px_var(--accent-glow)] scale-105\'\n                  : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n              }`}\n            >\n              <ArrowUp className=\"w-4 h-4\" />\n              <span>Over The Car (Top-Down Aerial)</span>\n            </button>\n\n            <button\n              id=\"view-orbit-btn\"\n              onClick={() => setElevation(\'orbit\')}\n              className={`px-4 py-2 rounded-xl text-xs font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n                elevation === \'orbit\'\n                  ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_20px_var(--accent-glow)] scale-105\'\n                  : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n              }`}\n            >\n              <RotateCw className=\"w-4 h-4\" />\n              <span>Sideways (360\302\260 Orbit)</span>\n            </button>\n\n            <button\n              id=\"view-under-btn\"\n              onClick={() => {\n                setElevation(\'under\');\n                setIsAutoRotating(false);\n              }}\n              className={`px-4 py-2 rounded-xl text-xs font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n                elevation === \'under\'\n                  ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_20px_var(--accent-glow)] scale-105\'\n                  : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n              }`}\n            >\n              <ArrowDown className=\"w-4 h-4\" />\n              <span>Under The Car (Chassis & Venturi)</span>\n            </button>\n          </div>\n        )}\n\n        {/* Main 360 Studio Container with -30px Hover Lift (Requirement 8) */}\n        <div\n          id=\"car-360-container\"\n          className=\"gk-hover-lift relative rounded-3xl bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[0_25px_70px_rgba(0,0,0,0.4)] overflow-hidden\"\n        >\n          {displayEngine === \'3d\' ? (\n            /* Interactive 3D WebGL Model Engine (Requirement 6) */\n            <Car3DCanvas onSelectHotspot={onSelectHotspot} />\n          ) : (\n            /* Photographic Multi-Elevation Studio Engine */"
      replacement_content: "        {/* Primary Engine Switcher: Sports Car (Sketchfab 3D from User Link) vs Three.js Prototype vs Multi-Elevation Telemetry */}\n        <div className=\"flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-6\">\n          {/* Option 1: Sports Car 3D (Sketchfab - Direct from user\'s provided link) */}\n          <button\n            id=\"engine-sketchfab-btn\"\n            onClick={() => setDisplayEngine(\'sketchfab\')}\n            className={`px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n              displayEngine === \'sketchfab\'\n                ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_30px_var(--accent-glow)] scale-105\'\n                : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n            }`}\n          >\n            <Car className=\"w-4 h-4 text-emerald-300\" />\n            <span>Sports Car 3D (Sketchfab)</span>\n            <span className=\"px-1.5 py-0.5 rounded text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n              Interactive 3D\n            </span>\n          </button>\n\n          {/* Option 2: Custom Three.js Prototype with LiDAR */}\n          <button\n            id=\"engine-3d-btn\"\n            onClick={() => setDisplayEngine(\'3d\')}\n            className={`px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n              displayEngine === \'3d\'\n                ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_30px_var(--accent-glow)] scale-105\'\n                : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n            }`}\n          >\n            <Box className=\"w-4 h-4 text-cyan-300\" />\n            <span>GK Hypercar (Three.js)</span>\n          </button>\n\n          {/* Option 3: Multi-Elevation Studio */}\n          <button\n            id=\"engine-multiaxis-btn\"\n            onClick={() => setDisplayEngine(\'multiAxis\')}\n            className={`px-4 sm:px-5 py-2.5 rounded-xl text-xs sm:text-sm font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n              displayEngine === \'multiAxis\'\n                ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_30px_var(--accent-glow)] scale-105\'\n                : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n            }`}\n          >\n            <RotateCw className=\"w-4 h-4\" />\n            <span>Multi-Elevation Studio</span>\n          </button>\n        </div>\n\n        {/* If Multi-Axis 2D is chosen, show perspective buttons (Over / Orbit / Under) */}\n        {displayEngine === \'multiAxis\' && (\n          <div className=\"flex flex-wrap items-center justify-center gap-2 sm:gap-4 mb-6 animate-fadeIn\">\n            <button\n              id=\"view-over-btn\"\n              onClick={() => {\n                setElevation(\'over\');\n                setIsAutoRotating(false);\n              }}\n              className={`px-4 py-2 rounded-xl text-xs font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n                elevation === \'over\'\n                  ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_20px_var(--accent-glow)] scale-105\'\n                  : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n              }`}\n            >\n              <ArrowUp className=\"w-4 h-4\" />\n              <span>Over The Car (Top-Down Aerial)</span>\n            </button>\n\n            <button\n              id=\"view-orbit-btn\"\n              onClick={() => setElevation(\'orbit\')}\n              className={`px-4 py-2 rounded-xl text-xs font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n                elevation === \'orbit\'\n                  ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_20px_var(--accent-glow)] scale-105\'\n                  : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n              }`}\n            >\n              <RotateCw className=\"w-4 h-4\" />\n              <span>Sideways (360\302\260 Orbit)</span>\n            </button>\n\n            <button\n              id=\"view-under-btn\"\n              onClick={() => {\n                setElevation(\'under\');\n                setIsAutoRotating(false);\n              }}\n              className={`px-4 py-2 rounded-xl text-xs font-mono-tech font-bold uppercase transition-all flex items-center gap-2 cursor-pointer ${\n                elevation === \'under\'\n                  ? \'bg-[var(--accent-cyan)] text-white shadow-[0_0_20px_var(--accent-glow)] scale-105\'\n                : \'bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-color)] hover:text-[var(--accent-cyan)] hover:border-[var(--accent-cyan)]\'\n              }`}\n            >\n              <ArrowDown className=\"w-4 h-4\" />\n              <span>Under The Car (Chassis & Venturi)</span>\n            </button>\n          </div>\n        )}\n\n        {/* Main 360 Studio Container with -30px Hover Lift */}\n        <div\n          id=\"car-360-container\"\n          className=\"gk-hover-lift relative rounded-3xl bg-[var(--bg-card)] border border-[var(--border-color)] shadow-[0_25px_70px_rgba(0,0,0,0.4)] overflow-hidden\"\n        >\n          {displayEngine === \'sketchfab\' ? (\n            /* Official 3D Sports Car Model from User\'s Link (Sketchfab WebGL) */\n            <SketchfabCarViewer onSelectHotspot={onSelectHotspot} />\n          ) : displayEngine === \'3d\' ? (\n            /* Interactive 3D WebGL Model Engine (Three.js LiDAR) */\n            <Car3DCanvas onSelectHotspot={onSelectHotspot} />\n          ) : (\n            /* Photographic Multi-Elevation Studio Engine */"
