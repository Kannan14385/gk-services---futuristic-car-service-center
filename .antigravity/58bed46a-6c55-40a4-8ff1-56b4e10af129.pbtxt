        }
        lines {
          text: "      state.phi += (state.targetPhi - state.phi) * state.damping;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      state.radius += (state.targetRadius - state.radius) * state.damping;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Convert spherical coordinates to camera Cartesian position"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      camera.position.x = state.target.x + state.radius * Math.sin(state.phi) * Math.sin(state.theta);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      camera.position.y = state.target.y + state.radius * Math.cos(state.phi);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      camera.position.z = state.target.z + state.radius * Math.sin(state.phi) * Math.cos(state.theta);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      camera.lookAt(state.target);"
