    replacement_infos {
      original_chunk {
        target_content: "import { CarHotspot, ServicePillar, TechChamber, TestimonialItem, FAQItem } from \'../types\';\n\n// Single Hypercar Multi-Axis Views (Isolated, NO background, transparent cutout)\n// The single \"GK Apex-1 Cyber Hypercar\" across all 360\302\260 orbital angles, plus Over-The-Car (Aerial) and Under-The-Car (Chassis)\n\nexport const SINGLE_CAR_MODELS = {\n  // 360\302\260 Horizontal Orbit (Eye-Level / Sideways)\n  orbit: [\n    {\n      angle: 0,\n      label: \'0\302\260 Front Fascia\',\n      src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'front\',\n      alt: \'GK Apex-1 Front Direct 0\302\260\'\n    },\n    {\n      angle: 45,\n      label: \'45\302\260 Front-Right Quarter\',\n      src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'front-quarter-right\',\n      alt: \'GK Apex-1 Front-Right 45\302\260\'\n    },\n    {\n      angle: 90,\n      label: \'90\302\260 Sideways Profile (Right)\',\n      src: \'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'profile-right\',\n      alt: \'GK Apex-1 Profile Right 90\302\260\'\n    },\n    {\n      angle: 135,\n      label: \'135\302\260 Rear-Right Quarter\',\n      src: \'https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'rear-quarter-right\',\n      alt: \'GK Apex-1 Rear-Right 135\302\260\'\n    },\n    {\n      angle: 180,\n      label: \'180\302\260 Rear Exhaust & Wing\',\n      src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'rear\',\n      alt: \'GK Apex-1 Rear 180\302\260\'\n    },\n    {\n      angle: 225,\n      label: \'225\302\260 Rear-Left Quarter\',\n      src: \'https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'rear-quarter-left\',\n      alt: \'GK Apex-1 Rear-Left 225\302\260\'\n    },\n    {\n      angle: 270,\n      label: \'270\302\260 Sideways Profile (Left)\',\n      src: \'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'profile-left\',\n      alt: \'GK Apex-1 Profile Left 270\302\260\'\n    },\n    {\n      angle: 315,\n      label: \'315\302\260 Front-Left Quarter\',\n      src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'front-quarter-left\',\n      alt: \'GK Apex-1 Front-Left 315\302\260\'\n    }\n  ],\n\n  // Over-The-Car (Top-Down Aerial View looking down on the carbon roof, NACA ducts, cockpit, and rear aero wing)\n  over: {\n    label: \'Over The Car (Top-Down Aerial Inspection)\',\n    description: \'Orthographic top-down inspection of carbon canopy, NACA cooling channels, twin-plane active wing, and solar telemetry skin.\',\n    src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1400&q=80\',\n    alt: \'GK Apex-1 Top-Down Aerial View\'\n  },\n\n  // Under-The-Car (Chassis Undercarriage View looking up at the flat-bottom venturi ground-effect floor, titanium exhaust bypass, and suspension)\n  under: {\n    label: \'Under The Car (Chassis & Undercarriage Inspection)\',\n    description: \'Ground-effect carbon fiber venturi undertray, titanium high-velocity exhaust channels, magnesium skid plates, and active pushrod dampers.\',\n    src: \'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1400&q=80\',\n    alt: \'GK Apex-1 Under The Car Chassis View\'\n  }\n};"
        replacement_content: "import { CarHotspot, ServicePillar, TechChamber, TestimonialItem, FAQItem, GalleryCar } from \'../types\';\n\n// Single Hypercar Multi-Axis Views (Isolated, NO background, transparent cutout)\n// The single \"GK Apex-1 Cyber Hypercar\" across all 360\302\260 orbital angles, plus Over-The-Car (Aerial) and Under-The-Car (Chassis)\n\nexport const SINGLE_CAR_MODELS = {\n  // 360\302\260 Horizontal Orbit (Eye-Level / Sideways)\n  orbit: [\n    {\n      angle: 0,\n      label: \'0\302\260 Front Fascia\',\n      src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'front\',\n      alt: \'GK Apex-1 Front Direct 0\302\260\'\n    },\n    {\n      angle: 45,\n      label: \'45\302\260 Front-Right Quarter\',\n      src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'front-quarter-right\',\n      alt: \'GK Apex-1 Front-Right 45\302\260\'\n    },\n    {\n      angle: 90,\n      label: \'90\302\260 Sideways Profile (Right)\',\n      src: \'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'profile-right\',\n      alt: \'GK Apex-1 Profile Right 90\302\260\'\n    },\n    {\n      angle: 135,\n      label: \'135\302\260 Rear-Right Quarter\',\n      src: \'https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'rear-quarter-right\',\n      alt: \'GK Apex-1 Rear-Right 135\302\260\'\n    },\n    {\n      angle: 180,\n      label: \'180\302\260 Rear Exhaust & Wing\',\n      src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'rear\',\n      alt: \'GK Apex-1 Rear 180\302\260\'\n    },\n    {\n      angle: 225,\n      label: \'225\302\260 Rear-Left Quarter\',\n      src: \'https://images.unsplash.com/photo-1618843479313-40f8afb4b4d8?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'rear-quarter-left\',\n      alt: \'GK Apex-1 Rear-Left 225\302\260\'\n    },\n    {\n      angle: 270,\n      label: \'270\302\260 Sideways Profile (Left)\',\n      src: \'https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'profile-left\',\n      alt: \'GK Apex-1 Profile Left 270\302\260\'\n    },\n    {\n      angle: 315,\n      label: \'315\302\260 Front-Left Quarter\',\n      src: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\',\n      vectorCutout: \'front-quarter-left\',\n      alt: \'GK Apex-1 Front-Left 315\302\260\'\n    }\n  ],\n\n  // Over-The-Car (Top-Down Aerial View looking down on the carbon roof, NACA ducts, cockpit, and rear aero wing)\n  over: {\n    label: \'Over The Car (Top-Down Aerial Inspection)\',\n    description: \'Orthographic top-down inspection of carbon canopy, NACA cooling channels, twin-plane active wing, and solar telemetry skin.\',\n    src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1400&q=80\',\n    alt: \'GK Apex-1 Top-Down Aerial View\'\n  },\n\n  // Under-The-Car (Chassis Undercarriage View looking up at the flat-bottom venturi ground-effect floor, titanium exhaust bypass, and suspension)\n  under: {\n    label: \'Under The Car (Chassis & Undercarriage Inspection)\',\n    description: \'Ground-effect carbon fiber venturi undertray, titanium high-velocity exhaust channels, magnesium skid plates, and active pushrod dampers.\',\n    src: \'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1400&q=80\',\n    alt: \'GK Apex-1 Under The Car Chassis View\'\n  }\n};\n\n// Comprehensive Multi-Studio Elevation Gallery of Cars\nexport const STUDIO_CAR_GALLERY: GalleryCar[] = [\n  {\n    id: \'car-apex-1\',\n    name: \'GK Apex-1 Prototype\',\n    codename: \'CHAMBER-01 // EXPERIMENTAL\',\n    brand: \'GK Autonomous Works\',\n    category: \'Prototype\',\n    tagline: \'Pure Aero Prototype with Tri-Motor Quantum Hybrid\',\n    thumbnail: \'https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=600&q=80\',\n    hp: \'1,050 BHP\',\n    topSpeed: \'355 km/h\',\n    zeroToSixty: \'2.1s\',\n    engine: \'Tri-Motor Quantum Flux Hybrid\',\n    downforce: \'1,200 kg @ 250 km/h\',\n    chassisScore: 99,\n    orbit: SINGLE_CAR_MODELS.orbit,\n    over: SINGLE_CAR_MODELS.over,\n    under: SINGLE_CAR_MODELS.under\n  },\n  {\n    id: \'car-gt3rs\',\n    name: \'Porsche 911 GT3 RS\',\n    codename: \'CHAMBER-02 // WEISSACH\',\n    brand: \'Porsche Motorsport\',\n    category: \'Track\',\n    tagline: \'High-Downforce DRS Track Weapon with 4.0L Boxer Engine\',\n    thumbnail: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=600&q=80\',\n    hp: \'518 BHP\',\n    topSpeed: \'296 km/h\',\n    zeroToSixty: \'3.0s\',\n    engine: \'4.0L Naturally Aspirated Boxer-6\',\n    downforce: \'860 kg @ 285 km/h\',\n    chassisScore: 98,\n    orbit: [\n      { angle: 0, label: \'0\302\260 Front Aero Grille\', src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS Front 0\302\260\' },\n      { angle: 45, label: \'45\302\260 Front Carbon Winglet\', src: \'https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS 45\302\260\' },\n      { angle: 90, label: \'90\302\260 Side Aero Louvers\', src: \'https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS Profile 90\302\260\' },\n      { angle: 135, label: \'135\302\260 Rear DRS Wing\', src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS 135\302\260\' },\n      { angle: 180, label: \'180\302\260 Rear Dual Titanium Exhaust\', src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS Rear 180\302\260\' },\n      { angle: 225, label: \'225\302\260 Rear-Left Quarter\', src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS 225\302\260\' },\n      { angle: 270, label: \'270\302\260 Left Profile Intake\', src: \'https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS 270\302\260\' },\n      { angle: 315, label: \'315\302\260 Front-Left Splitter\', src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1200&q=80\', alt: \'Porsche 911 GT3 RS 315\302\260\' }\n    ],\n    over: {\n      label: \'GT3 RS Aerial Roof & DRS Flow Inspection\',\n      description: \'Single central-radiator hood extractors, double-bubble magnesium roof fins, and active hydraulic DRS top element.\',\n      src: \'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'Porsche 911 GT3 RS Top-Down Aerial View\'\n    },\n    under: {\n      label: \'GT3 RS Double-Wishbone & Underbody Blades\',\n      description: \'Aerodynamically teardrop-profiled front double wishbones generating 40kg downforce, flat underfloor NACA brake ducts.\',\n      src: \'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'Porsche 911 GT3 RS Underbody Chassis View\'\n    }\n  },\n  {\n    id: \'car-296gtb\',\n    name: \'Ferrari 296 GTB Assetto\',\n    codename: \'CHAMBER-03 // FIORANO\',\n    brand: \'Ferrari Maranello\',\n    category: \'Supercar\',\n    tagline: \'Twin-Turbo 120\302\260 V6 Plug-In Hybrid with Multimatic Suspension\',\n    thumbnail: \'https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=600&q=80\',\n    hp: \'819 BHP\',\n    topSpeed: \'330 km/h\',\n    zeroToSixty: \'2.9s\',\n    engine: \'3.0L Twin-Turbo 120\302\260 V6 + MGU-K Hybrid\',\n    downforce: \'360 kg @ 250 km/h\',\n    chassisScore: 97,\n    orbit: [\n      { angle: 0, label: \'0\302\260 Front Tea-Tray Aero\', src: \'https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB Front 0\302\260\' },\n      { angle: 45, label: \'45\302\260 Front-Right Arch\', src: \'https://images.unsplash.com/photo-1592198084033-aade902d1aae?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB 45\302\260\' },\n      { angle: 90, label: \'90\302\260 B-Pillar Air Scoop\', src: \'https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB 90\302\260\' },\n      { angle: 135, label: \'135\302\260 Rear Active Spoiler\', src: \'https://images.unsplash.com/photo-1592198084033-aade902d1aae?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB 135\302\260\' },\n      { angle: 180, label: \'180\302\260 Center Exhaust Port\', src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB Rear 180\302\260\' },\n      { angle: 225, label: \'225\302\260 Rear-Left Buttress\', src: \'https://images.unsplash.com/photo-1592198084033-aade902d1aae?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB 225\302\260\' },\n      { angle: 270, label: \'270\302\260 Left Profile Carbon Skirt\', src: \'https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB 270\302\260\' },\n      { angle: 315, label: \'315\302\260 Front-Left Headlamp Vent\', src: \'https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=1200&q=80\', alt: \'Ferrari 296 GTB 315\302\260\' }\n    ],\n    over: {\n      label: \'Ferrari 296 Flying Buttress & Glass Engine Bay\',\n      description: \'Assetto Fiorano Lexan ultralight rear window, carbon fiber front bib, and roofline air channel directing high-speed airflow into the intercoolers.\',\n      src: \'https://images.unsplash.com/photo-1583121274602-3e2820c69888?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'Ferrari 296 GTB Top-Down Aerial View\'\n    },\n    under: {\n      label: \'Multimatic Spool-Valve Dampers & Underbody Venturi\',\n      description: \'Fixed-rate race-derived Multimatic spool-valve shock absorbers, front inverted spoiler underbody channel, and ceramic thermal shielding.\',\n      src: \'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'Ferrari 296 GTB Underbody Chassis View\'\n    }\n  },\n  {\n    id: \'car-sto\',\n    name: \'Lamborghini Hurac\303\241n STO\',\n    codename: \'CHAMBER-04 // CORSE\',\n    brand: \'Squadra Corse\',\n    category: \'Track\',\n    tagline: \'Naturally Aspirated V10 Homologation with One-Piece Cofango\',\n    thumbnail: \'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=600&q=80\',\n    hp: \'631 BHP\',\n    topSpeed: \'310 km/h\',\n    zeroToSixty: \'3.0s\',\n    engine: \'5.2L Naturally Aspirated High-Rev V10\',\n    downforce: \'420 kg @ 280 km/h\',\n    chassisScore: 97,\n    orbit: [\n      { angle: 0, label: \'0\302\260 Cofango Integrated Air Ducts\', src: \'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO Front 0\302\260\' },\n      { angle: 45, label: \'45\302\260 Front Carbon Splitter\', src: \'https://images.unsplash.com/photo-1519245659620-e859806a8d3b?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO 45\302\260\' },\n      { angle: 90, label: \'90\302\260 Side Shark Fin & Louvers\', src: \'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO 90\302\260\' },\n      { angle: 135, label: \'135\302\260 Manual 3-Position Wing\', src: \'https://images.unsplash.com/photo-1519245659620-e859806a8d3b?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO 135\302\260\' },\n      { angle: 180, label: \'180\302\260 Rear High-Mount Dual Pipes\', src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO Rear 180\302\260\' },\n      { angle: 225, label: \'225\302\260 Rear Carbon Diffuser Arch\', src: \'https://images.unsplash.com/photo-1519245659620-e859806a8d3b?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO 225\302\260\' },\n      { angle: 270, label: \'270\302\260 Left Profile Intake Strakes\', src: \'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO 270\302\260\' },\n      { angle: 315, label: \'315\302\260 Front-Left Wheel Well Pressure Vents\', src: \'https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1200&q=80\', alt: \'Hurac\303\241n STO 315\302\260\' }\n    ],\n    over: {\n      label: \'STO Integrated Roof Scoop & Shark Fin\',\n      description: \'Rear engine decklid louvers for rapid thermal extraction, aerodynamic shark fin enhancing yaw stability through apex curves.\',\n      src: \'https://images.unsplash.com/photo-1519245659620-e859806a8d3b?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'Hurac\303\241n STO Top-Down Aerial View\'\n    },\n    under: {\n      label: \'CCM-R F1 Carbon Brakes & Titanium Skid Plate\',\n      description: \'Brembo CCM-R carbon-ceramic discs with 4x thermal conductivity, rear air diffusers directing flow past rear axle.\',\n      src: \'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'Hurac\303\241n STO Underbody Chassis View\'\n    }\n  },\n  {\n    id: \'car-765lt\',\n    name: \'McLaren 765LT Spider\',\n    codename: \'CHAMBER-05 // LONGTAIL\',\n    brand: \'McLaren Woking\',\n    category: \'Hypercar\',\n    tagline: \'Carbon Fiber Monocage II with Active Longtail Airbrake\',\n    thumbnail: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=600&q=80\',\n    hp: \'755 BHP\',\n    topSpeed: \'330 km/h\',\n    zeroToSixty: \'2.7s\',\n    engine: \'4.0L Twin-Turbo Flat-Plane V8 (M840T)\',\n    downforce: \'Active Longtail DRS Airbrake\',\n    chassisScore: 99,\n    orbit: [\n      { angle: 0, label: \'0\302\260 Low-Nose Splitter & Laser Eyes\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT Front 0\302\260\' },\n      { angle: 45, label: \'45\302\260 Carbon Front Blade\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT 45\302\260\' },\n      { angle: 90, label: \'90\302\260 Extended Longtail Profile\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT 90\302\260\' },\n      { angle: 135, label: \'135\302\260 Active Airbrake Extended\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT 135\302\260\' },\n      { angle: 180, label: \'180\302\260 Quad-Center Titanium Exhaust Pipes\', src: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT Rear 180\302\260\' },\n      { angle: 225, label: \'225\302\260 Rear Carbon Diffuser Blades\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT 225\302\260\' },\n      { angle: 270, label: \'270\302\260 Left Carbon Side Skirt & Door Blades\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT 270\302\260\' },\n      { angle: 315, label: \'315\302\260 Front Left Fenders with Air Extraction\', src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1200&q=80\', alt: \'McLaren 765LT 315\302\260\' }\n    ],\n    over: {\n      label: \'McLaren Monocage II Carbon Cockpit & Deck\',\n      description: \'One-piece carbon fiber canopy structure, glazed C-pillars improving 360 rear visibility, and high-velocity central quad exhaust shielding.\',\n      src: \'https://images.unsplash.com/photo-1621135802920-133df287f89c?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'McLaren 765LT Top-Down Aerial View\'\n    },\n    under: {\n      label: \'McLaren Full Carbon Floor & Proactive Chassis Control II\',\n      description: \'Hydraulically cross-linked suspension eliminating physical anti-roll bars, carbon fiber full venturi tunnel flat undertray.\',\n      src: \'https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1400&q=80\',\n      alt: \'McLaren 765LT Underbody Chassis View\'\n    }\n  }\n];"
      }
      num_matches: 1
    }
  }
