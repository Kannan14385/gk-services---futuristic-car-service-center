    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Radio, CheckCircle, Calendar, ShieldCheck, Car, Clock, Send, Sparkles } from \'lucide-react\';\n\ninterface ContactModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  prefillData?: {\n    serviceName?: string;\n    vehicleType?: string;\n    totalEstimate?: number;\n  };\n}\n\nexport const ContactModal: React.FC<ContactModalProps> = ({ isOpen, onClose, prefillData }) => {\n  const [fullName, setFullName] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [phone, setPhone] = useState(\'\');\n  const [carModel, setCarModel] = useState(prefillData?.vehicleType || \'\');\n  const [serviceRequested, setServiceRequested] = useState(prefillData?.serviceName || \'Autonomous Laser Diagnostic Scan\');\n  const [preferredDate, setPreferredDate] = useState(\'2026-09-25\');\n  const [preferredChamber, setPreferredChamber] = useState(\'Chamber Alpha (Laser Dock)\');\n  const [isSubmitted, setIsSubmitted] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsSubmitted(true);\n  };\n\n  const handleResetAndClose = () => {\n    setIsSubmitted(false);\n    onClose();\n  };\n\n  return (\n    <div\n      id=\"contact-modal-backdrop\"\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 bg-black/85 backdrop-blur-xl animate-fadeIn\"\n      onClick={(e) => {\n        if (e.target === e.currentTarget) onClose();\n      }}\n    >\n      <div\n        id=\"contact-modal-container\"\n        className=\"relative w-full max-w-xl bg-[#0a0e17] border border-[#00f0ff]/50 rounded-2xl shadow-[0_0_50px_rgba(0,240,255,0.3)] overflow-hidden\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Modal Header */}\n        <div className=\"relative px-6 py-4 border-b border-[#00f0ff]/20 flex items-center justify-between bg-gradient-to-r from-[#0d1322] via-[#0a0e17] to-[#0d1322]\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"p-2 rounded-lg bg-[#00f0ff]/10 border border-[#00f0ff]/30 text-[#00f0ff]\">\n              <Radio className=\"w-5 h-5 animate-pulse\" />\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono-tech uppercase tracking-widest text-[#00f0ff]\">\n                DIRECT BAY DOCK DISPATCH\n              </span>\n              <h3 className=\"font-orbitron font-bold text-lg text-white\">\n                RESERVE GK SERVICE DOCK\n              </h3>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-2 text-[#94a3b8] hover:text-[#00f0ff] hover:bg-[#00f0ff]/10 rounded-lg transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6\">\n          {isSubmitted ? (\n            <div className=\"py-8 text-center space-y-4\">\n              <div className=\"w-16 h-16 mx-auto rounded-full bg-emerald-950/80 border-2 border-emerald-400 flex items-center justify-center text-emerald-400 shadow-[0_0_30px_rgba(52,211,153,0.4)]\">\n                <CheckCircle className=\"w-8 h-8\" />\n              </div>\n\n              <span className=\"text-xs font-mono-tech text-emerald-400 uppercase tracking-widest block\">\n                RESERVATION CONFIRMED \302\267 TOKEN #GK-2026-{Math.floor(1000 + Math.random() * 9000)}\n              </span>\n\n              <h4 className=\"font-orbitron font-bold text-2xl text-white\">\n                DOCK SLOT ALLOCATED\n              </h4>\n\n              <p className=\"text-xs sm:text-sm text-[#94a3b8] max-w-md mx-auto leading-relaxed\">\n                Thank you, <strong className=\"text-white\">{fullName || \'Pilot\'}</strong>. Your priority service reservation for <strong className=\"text-[#00f0ff]\">{carModel || \'your vehicle\'}</strong> has been locked in <strong className=\"text-white\">{preferredChamber}</strong> for <strong className=\"text-white\">{preferredDate}</strong>.\n              </p>\n\n              <div className=\"p-4 rounded-xl bg-[#0d1322] border border-[#00f0ff]/20 max-w-sm mx-auto text-xs font-mono-tech text-[#cbd5e1] text-left space-y-1.5\">\n                <div className=\"flex justify-between\">\n                  <span>TELEMETRY PASS:</span>\n                  <span className=\"text-emerald-400\">ACTIVE</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>FACILITY ADDRESS:</span>\n                  <span className=\"text-white\">Gate 4, Quantum Blvd</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>PRE-CHECKIN TIME:</span>\n                  <span className=\"text-[#00f0ff]\">08:30 AM UTC</span>\n                </div>\n              </div>\n\n              <div className=\"pt-4\">\n                <button\n                  onClick={handleResetAndClose}\n                  className=\"gk-btn text-xs py-2.5 px-6\"\n                >\n                  <span>Return to Mission Hub</span>\n                </button>\n              </div>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                    PILOT / OWNER NAME *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={fullName}\n                    onChange={(e) => setFullName(e.target.value)}\n                    placeholder=\"e.g. Alex Mercer\"\n                    className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                    COMMUNICATIONS EMAIL *\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"pilot@domain.com\"\n                    className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                    TELEMETRY CONTACT (PHONE)\n                  </label>\n                  <input\n                    type=\"tel\"\n                    value={phone}\n                    onChange={(e) => setPhone(e.target.value)}\n                    placeholder=\"+1 (555) 019-2834\"\n                    className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                    VEHICLE MAKE & MODEL *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    value={carModel}\n                    onChange={(e) => setCarModel(e.target.value)}\n                    placeholder=\"e.g. Porsche 911 GT3 RS / Model S\"\n                    className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                    SERVICE PROTOCOL\n                  </label>\n                  <select\n                    value={serviceRequested}\n                    onChange={(e) => setServiceRequested(e.target.value)}\n                    className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                  >\n                    <option>Autonomous Laser Diagnostic Scan ($180)</option>\n                    <option>Graphene Nano-Shield 9H Armor ($650)</option>\n                    <option>Quantum Dyno Tuning & Powertrain ($420)</option>\n                    <option>Carbon-Ceramic Braking Overhaul ($340)</option>\n                    <option>Cryogenic -78.5\302\260C Carbon Blast ($310)</option>\n                    <option>Complete Apex Overhaul Package</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                    TARGET CALENDAR DATE\n                  </label>\n                  <input\n                    type=\"date\"\n                    value={preferredDate}\n                    onChange={(e) => setPreferredDate(e.target.value)}\n                    className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-[11px] font-mono-tech text-[#00f0ff] uppercase block mb-1\">\n                  ASSIGNED ROBOTIC CHAMBER\n                </label>\n                <select\n                  value={preferredChamber}\n                  onChange={(e) => setPreferredChamber(e.target.value)}\n                  className=\"w-full bg-[#07090e] border border-[#00f0ff]/30 rounded-lg px-3 py-2 text-xs font-mono-tech text-white focus:outline-none focus:border-[#00f0ff]\"\n                >\n                  <option>Chamber Alpha (LiDAR Scan & Alignment Dock)</option>\n                  <option>Chamber Beta (Zero-Gravity Fluid Station)</option>\n                  <option>Chamber Gamma (Graphene Infrared Curing Vault)</option>\n                  <option>Chamber Delta (Quantum Dyno Chamber)</option>\n                </select>\n              </div>\n\n              <div className=\"pt-2\">\n                <button\n                  type=\"submit\"\n                  className=\"gk-btn w-full justify-center text-sm py-3\"\n                >\n                  <Send className=\"w-4 h-4\" />\n                  <span>DISPATCH PRIORITY DOCK RESERVATION</span>\n                </button>\n              </div>\n\n              <div className=\"flex items-center justify-between text-[10px] font-mono-tech text-[#94a3b8] pt-1\">\n                <span>\342\234\223 ZERO DEPOSIT REQUIRED</span>\n                <span>\342\234\223 CONFIRMATION TRANSMITTED IN 60s</span>\n              </div>\n            </form>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
