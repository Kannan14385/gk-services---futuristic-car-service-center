    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Radio, Activity, Cpu, Thermometer, ShieldCheck, Play, CheckCircle, Terminal } from \'lucide-react\';\nimport { TECH_CHAMBERS } from \'../data/mockCarData\';\n\nexport const TechBaySection: React.FC = () => {\n  const [activeChamberId, setActiveChamberId] = useState<string>(TECH_CHAMBERS[0].id);\n\n  const activeChamber = TECH_CHAMBERS.find((c) => c.id === activeChamberId) || TECH_CHAMBERS[0];\n\n  return (\n    <section\n      id=\"technology\"\n      className=\"relative py-24 sm:py-32 px-4 sm:px-6 lg:px-8 border-b border-[#00f0ff]/15 bg-[#07090e] cyber-grid overflow-hidden\"\n    >\n      <div className=\"max-w-7xl mx-auto relative z-10\">\n        {/* Section Heading */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6\">\n          <div>\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#00f0ff]/10 border border-[#00f0ff]/30 text-[#00f0ff] text-xs font-mono-tech uppercase tracking-widest mb-3\">\n              <Radio className=\"w-3.5 h-3.5 animate-pulse\" />\n              <span>Section 04 \302\267 Autonomous Infrastructure</span>\n            </div>\n            <h2 className=\"gk-font-h2 font-orbitron font-black tracking-tight text-white\">\n              ROBOTIC BAYS & <span className=\"text-[#00f0ff]\">CLEANROOM STACK</span>\n            </h2>\n            <p className=\"mt-2 text-sm sm:text-base text-[#94a3b8] max-w-2xl font-rajdhani font-medium tracking-wide\">\n              Step inside our four hermetically sealed robotics chambers. Real-time air purification, infrared curing grids, and automated multi-axis LiDAR gantries execute maintenance without human contamination.\n            </p>\n          </div>\n\n          {/* Chamber Switcher Tabs */}\n          <div className=\"flex flex-wrap gap-2 p-1.5 rounded-xl bg-[#0d1322] border border-[#00f0ff]/25\">\n            {TECH_CHAMBERS.map((chamber) => (\n              <button\n                key={chamber.id}\n                id={`chamber-tab-${chamber.id}`}\n                onClick={() => setActiveChamberId(chamber.id)}\n                className={`px-3 py-2 text-xs font-mono-tech uppercase rounded-lg transition-all flex items-center gap-2 ${\n                  chamber.id === activeChamberId\n                    ? \'bg-[#00f0ff] text-[#07090e] font-bold shadow-[0_0_15px_rgba(0,240,255,0.6)]\'\n                    : \'text-[#94a3b8] hover:text-[#00f0ff] hover:bg-[#00f0ff]/10\'\n                }`}\n              >\n                <span className={`w-2 h-2 rounded-full ${chamber.status === \'ACTIVE\' ? \'bg-emerald-400 animate-ping\' : \'bg-[#00f0ff]\'}`} />\n                <span>{chamber.name}</span>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* Dynamic Chamber Display Box with -30px Hover Lift (Requirement 8) */}\n        <div\n          id=\"chamber-active-container\"\n          className=\"gk-hover-lift relative rounded-3xl bg-gradient-to-b from-[#0d1322] to-[#0a0e17] border border-[#00f0ff]/30 p-6 sm:p-10 shadow-[0_20px_60px_rgba(0,0,0,0.8)]\"\n        >\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            {/* Left Side: Chamber Telemetry & Description */}\n            <div className=\"lg:col-span-7 space-y-6\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"px-3 py-1 rounded bg-[#00f0ff]/10 border border-[#00f0ff]/30 text-xs font-mono-tech text-[#00f0ff]\">\n                  {activeChamber.codename}\n                </span>\n                <span className=\"flex items-center gap-1 text-xs font-mono-tech text-emerald-400\">\n                  <CheckCircle className=\"w-3.5 h-3.5\" />\n                  STATUS: {activeChamber.status}\n                </span>\n              </div>\n\n              <h3 className=\"font-orbitron font-bold text-2xl sm:text-3xl text-white\">\n                {activeChamber.name}\n              </h3>\n\n              <p className=\"text-sm sm:text-base text-[#cbd5e1] leading-relaxed\">\n                {activeChamber.description}\n              </p>\n\n              {/* Environmental Sensor Stats */}\n              <div className=\"grid grid-cols-3 gap-4 pt-4 border-t border-[#00f0ff]/15\">\n                <div className=\"p-3 rounded-xl bg-[#07090e] border border-[#00f0ff]/15\">\n                  <span className=\"text-[10px] font-mono-tech text-[#94a3b8] block uppercase\">\n                    SCAN PRECISION\n                  </span>\n                  <span className=\"font-orbitron font-bold text-sm sm:text-base text-[#00f0ff]\">\n                    {activeChamber.scanPrecision}\n                  </span>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#07090e] border border-[#00f0ff]/15\">\n                  <span className=\"text-[10px] font-mono-tech text-[#94a3b8] block uppercase\">\n                    ENVIRONMENT TEMP\n                  </span>\n                  <span className=\"font-orbitron font-bold text-sm sm:text-base text-amber-400\">\n                    {activeChamber.temperature}\n                  </span>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#07090e] border border-[#00f0ff]/15\">\n                  <span className=\"text-[10px] font-mono-tech text-[#94a3b8] block uppercase\">\n                    AIR PURITY\n                  </span>\n                  <span className=\"font-orbitron font-bold text-sm sm:text-base text-emerald-400\">\n                    {activeChamber.atmosphere}\n                  </span>\n                </div>\n              </div>\n\n              {/* Hardware Features Bullet List */}\n              <div className=\"space-y-2.5 pt-2\">\n                <span className=\"text-xs font-mono-tech text-[#00f0ff] uppercase block\">\n                  DEPLOYED SUBSYSTEMS\n                </span>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                  {activeChamber.features.map((feature, i) => (\n                    <div key={i} className=\"flex items-center gap-2 text-xs font-mono-tech text-[#cbd5e1]\">\n                      <div className=\"w-1.5 h-1.5 rounded-full bg-[#00f0ff]\" />\n                      <span>{feature}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            </div>\n\n            {/* Right Side: Chamber Live Telemetry Terminal */}\n            <div className=\"lg:col-span-5 relative\">\n              <div className=\"rounded-2xl bg-[#07090e] border border-[#00f0ff]/30 p-5 shadow-2xl\">\n                {/* Simulated Terminal Header */}\n                <div className=\"flex items-center justify-between pb-3 border-b border-[#00f0ff]/20 text-xs font-mono-tech text-[#94a3b8]\">\n                  <div className=\"flex items-center gap-2\">\n                    <Terminal className=\"w-3.5 h-3.5 text-[#00f0ff]\" />\n                    <span className=\"text-white font-semibold\">TERMINAL://GK-CHAMBER-STREAM</span>\n                  </div>\n                  <span className=\"text-emerald-400\">ONLINE</span>\n                </div>\n\n                {/* Telemetry Metrics Gauges */}\n                <div className=\"py-6 space-y-4\">\n                  {activeChamber.telemetryMetrics.map((metric, i) => (\n                    <div key={i} className=\"space-y-1.5\">\n                      <div className=\"flex items-center justify-between text-xs font-mono-tech\">\n                        <span className=\"text-[#94a3b8]\">{metric.label}</span>\n                        <span className=\"font-orbitron text-[#00f0ff] font-bold\">\n                          {metric.value} <span className=\"text-xs text-[#94a3b8] font-normal\">{metric.unit}</span>\n                        </span>\n                      </div>\n                      {/* Animated Laser Bar */}\n                      <div className=\"w-full h-1.5 bg-[#0d1322] rounded-full overflow-hidden border border-[#00f0ff]/20\">\n                        <div\n                          className=\"h-full bg-gradient-to-r from-[#00f0ff] to-[#38bdf8] rounded-full\"\n                          style={{ width: `${65 + i * 14}%` }}\n                        />\n                      </div>\n                    </div>\n                  ))}\n                </div>\n\n                {/* Chamber Live Video Feed Placeholder with Laser Scan Lines */}\n                <div className=\"relative h-44 rounded-xl overflow-hidden border border-[#00f0ff]/20 bg-black/70 flex items-center justify-center\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1542282088-72c9c27ed0cd?auto=format&fit=crop&w=800&q=80\"\n                    alt=\"Autonomous Robotic Chamber Feed\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover opacity-60\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/30\" />\n                  \n                  {/* Glowing Laser Scan Line */}\n                  <div className=\"absolute inset-x-0 h-[2px] bg-[#00f0ff] shadow-[0_0_10px_#00f0ff] animate-bounce top-1/3\" />\n\n                  <div className=\"absolute top-2 left-2 text-[10px] font-mono-tech text-emerald-400 bg-black/80 px-2 py-0.5 rounded border border-emerald-500/30\">\n                    REC \302\267 CAM_BAY_0{activeChamber.id.slice(-1)}\n                  </div>\n                  <div className=\"absolute bottom-2 right-2 text-[10px] font-mono-tech text-[#00f0ff] bg-black/80 px-2 py-0.5 rounded\">\n                    LASER SPECTROMETRY ACTIVE\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
