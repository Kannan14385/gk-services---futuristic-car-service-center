  file_change {
    absolute_path_uri: "file:///src/components/HeroSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Cpu, ArrowUpRight, Play, Zap, Compass, Activity, CheckCircle2 } from \'lucide-react\';\n\ninterface HeroSectionProps {\n  onOpenContact: () => void;\n  onExplore360: () => void;\n}\n\nexport const HeroSection: React.FC<HeroSectionProps> = ({ onOpenContact, onExplore360 }) => {\n  return (\n    <section\n      id=\"hero\"\n      className=\"relative min-h-[90vh] flex flex-col justify-center pt-8 pb-20 px-4 sm:px-6 lg:px-8 border-b border-[var(--border-color)] bg-[var(--bg-primary)] cyber-radial-glow overflow-hidden\"\n    >\n      {/* Laser Light Strands & Grid Matrix */}\n      <div className=\"absolute inset-0 cyber-grid opacity-30 pointer-events-none\" />\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] bg-[var(--accent-cyan)]/10 rounded-full blur-[160px] pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto w-full relative z-10\">\n        {/* Top Telemetry Status Pill */}\n        <div className=\"flex items-center gap-3 mb-6\">\n          <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-card)] border border-[var(--border-color)] text-xs font-mono-tech text-[var(--accent-cyan)] shadow-[0_0_15px_var(--accent-glow)]\">\n            <span className=\"relative flex h-2 w-2\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-400\"></span>\n            </span>\n            <span className=\"uppercase tracking-widest\">GK DOCK TELEMETRY \302\267 4 ROBOTIC BAYS ACTIVE</span>\n          </div>\n\n          <div className=\"hidden sm:inline-flex items-center gap-2 text-xs font-mono-tech text-[var(--text-secondary)]\">\n            <Activity className=\"w-3.5 h-3.5 text-[var(--accent-cyan)]\" />\n            <span>CALIBRATION PROTOCOL: ISO-9001-AERO</span>\n          </div>\n        </div>\n\n        {/* Main Headline & Two-Column Grid */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n          {/* Left Column: Mission Content */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            <h1 className=\"gk-font-display font-primary font-black tracking-tight text-[var(--text-primary)] uppercase\">\n              NEXT-GEN <br />\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-[var(--accent-cyan)] via-sky-400 to-blue-500 drop-shadow-[0_0_25px_var(--accent-glow)]\">\n                PRECISION\n              </span>{\' \'}\n              CAR SERVICE\n            </h1>\n\n            <p className=\"gk-font-body font-rajdhani text-lg sm:text-xl text-[var(--text-secondary)] max-w-2xl font-medium tracking-wide leading-relaxed\">\n              Welcome to <strong className=\"text-[var(--text-primary)]\">GK Services</strong> \342\200\224 where aerospace engineering meets autonomous robotic maintenance. We eliminate human margin of error using sub-micron optical LiDAR scans, molecular ceramic armor, and quantum dyno telemetry.\n            </p>\n\n            {/* Universal Buttons with Universal Hover Effects (Requirement 5) */}\n            <div className=\"pt-2 flex flex-wrap items-center gap-4\">\n              <button\n                id=\"hero-book-btn\"\n                onClick={onOpenContact}\n                className=\"gk-btn text-sm sm:text-base py-3.5 px-8\"\n              >\n                <Zap className=\"w-4 h-4 text-[var(--accent-cyan)] group-hover:text-white transition-colors\" />\n                <span>Reserve Diagnostic Dock</span>\n              </button>\n\n              <button\n                id=\"hero-360-btn\"\n                onClick={onExplore360}\n                className=\"gk-btn gk-btn-secondary text-sm sm:text-base py-3.5 px-7\"\n              >\n                <Compass className=\"w-4 h-4 text-[var(--accent-cyan)]\" />\n                <span>Launch 360\302\260 Inspection</span>\n              </button>\n            </div>\n\n            {/* Quick Guarantees checklist */}\n            <div className=\"pt-6 grid grid-cols-2 sm:grid-cols-3 gap-4 border-t border-[var(--border-color)]\">\n              <div className=\"flex items-center gap-2 text-xs font-mono-tech text-[var(--text-secondary)]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[var(--accent-cyan)] shrink-0\" />\n                <span>Zero Margin of Error</span>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-mono-tech text-[var(--text-secondary)]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[var(--accent-cyan)] shrink-0\" />\n                <span>5-Year Ceramic Defense</span>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-mono-tech text-[var(--text-secondary)]\">\n                <CheckCircle2 className=\"w-4 h-4 text-[var(--accent-cyan)] shrink-0\" />\n                <span>Instant HUD Telemetry</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Hero Concept Visual Card with Holographic HUD */}\n          <div className=\"lg:col-span-5 relative\">\n            <div className=\"relative rounded-3xl p-1 bg-gradient-to-b from-[var(--accent-cyan)]/40 via-[var(--accent-cyan)]/10 to-transparent shadow-[0_0_50px_var(--accent-glow)]\">\n              <div className=\"relative rounded-[22px] overflow-hidden bg-[var(--bg-card)] border border-[var(--border-color)]\">\n                {/* Hero Car Showcase Graphic */}\n                <div className=\"relative h-80 sm:h-96 w-full overflow-hidden\">\n                  <img\n                    src=\"https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80\"\n                    alt=\"GK Services Autonomous Bay Hypercar\"\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover object-center filter contrast-110\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-[var(--bg-card)] via-transparent to-black/30\" />\n\n                  {/* Laser Scan HUD Overlay */}\n                  <div className=\"absolute top-4 left-4 right-4 flex items-center justify-between text-xs font-mono-tech text-[var(--accent-cyan)] bg-[var(--bg-card)]/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-[var(--border-color)]\">\n                    <span className=\"flex items-center gap-1.5\">\n                      <span className=\"w-1.5 h-1.5 rounded-full bg-[var(--accent-cyan)] animate-ping\" />\n                      AUTONOMOUS SCAN BAY\n                    </span>\n                    <span>FRAME: 0.005mm</span>\n                  </div>\n\n                  {/* Hotspot indicator on hero */}\n                  <div\n                    onClick={onExplore360}\n                    className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 cursor-pointer group/pin\"\n                  >\n                    <span className=\"animate-radar absolute inline-flex h-12 w-12 -top-3 -left-3 rounded-full bg-[var(--accent-cyan)]/40\" />\n                    <div className=\"relative px-3 py-1.5 rounded-full bg-[var(--bg-card)]/90 border border-[var(--accent-cyan)] text-xs font-mono-tech text-[var(--accent-cyan)] flex items-center gap-1.5 shadow-[0_0_20px_var(--accent-glow)] group-hover/pin:scale-110 transition-transform\">\n                      <Compass className=\"w-3.5 h-3.5\" />\n                      <span>ENTER 360\302\260 LAB</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom Telemetry HUD */}\n                <div className=\"p-5 bg-[var(--bg-card-subtle)] border-t border-[var(--border-color)]\">\n                  <div className=\"grid grid-cols-3 gap-3 text-center\">\n                    <div className=\"p-2 rounded-lg bg-[var(--bg-card)] border border-[var(--border-color)]\">\n                      <div className=\"text-[10px] font-mono-tech text-[var(--text-secondary)]\">RESTORE RATE</div>\n                      <div className=\"font-primary font-bold text-sm sm:text-base text-[var(--accent-cyan)]\">99.8%</div>\n                    </div>\n                    <div className=\"p-2 rounded-lg bg-[var(--bg-card)] border border-[var(--border-color)]\">\n                      <div className=\"text-[10px] font-mono-tech text-[var(--text-secondary)]\">ACCURACY</div>\n                      <div className=\"font-primary font-bold text-sm sm:text-base text-emerald-400\">\302\2610.01mm</div>\n                    </div>\n                    <div className=\"p-2 rounded-lg bg-[var(--bg-card)] border border-[var(--border-color)]\">\n                      <div className=\"text-[10px] font-mono-tech text-[var(--text-secondary)]\">DYNO GAIN</div>\n                      <div className=\"font-primary font-bold text-sm sm:text-base text-[var(--accent-cyan)]\">+48 BHP</div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* 3 Metric Summary Containers with -30px Hover Lift (Requirement 8) */}\n        <div className=\"mt-16 grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div\n            id=\"hero-stat-card-1\"\n            className=\"gk-hover-lift p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-color)] backdrop-blur-md shadow-md\"\n          >\n            <div className=\"flex items-center justify-between mb-4\">\n              <span className=\"text-xs font-mono-tech text-[var(--accent-cyan)] uppercase\">PILLAR I \302\267 OPTICS</span>\n              <div className=\"p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--accent-cyan)] border border-[var(--border-color)]\">\n                <Cpu className=\"w-5 h-5\" />\n              </div>\n            </div>\n            <h3 className=\"font-primary font-bold text-xl text-[var(--text-primary)] mb-2\">LiDAR 48-Pt Scan</h3>\n            <p className=\"text-xs text-[var(--text-secondary)] leading-relaxed\">\n              Every vehicle undergoes full robotic laser verification detecting frame twisting, wheel camber deviations, and suspension deflection in seconds.\n            </p>\n          </div>\n\n          <div\n            id=\"hero-stat-card-2\"\n            className=\"gk-hover-lift p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-color)] backdrop-blur-md shadow-md\"\n          >\n            <div className=\"flex items-center justify-between mb-4\">\n              <span className=\"text-xs font-mono-tech text-[var(--accent-cyan)] uppercase\">PILLAR II \302\267 ARMOR</span>\n              <div className=\"p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--accent-cyan)] border border-[var(--border-color)]\">\n                <ShieldCheck className=\"w-5 h-5\" />\n              </div>\n            </div>\n            <h3 className=\"font-primary font-bold text-xl text-[var(--text-primary)] mb-2\">9H Graphene Shield</h3>\n            <p className=\"text-xs text-[var(--text-secondary)] leading-relaxed\">\n              Molecular ceramic synthesis cured under shortwave infrared arrays, providing extreme hardness, UV immunity, and self-healing elasticity.\n            </p>\n          </div>\n\n          <div\n            id=\"hero-stat-card-3\"\n            className=\"gk-hover-lift p-6 rounded-2xl bg-[var(--bg-card)] border border-[var(--border-color)] backdrop-blur-md shadow-md\"\n          >\n            <div className=\"flex items-center justify-between mb-4\">\n              <span className=\"text-xs font-mono-tech text-[var(--accent-cyan)] uppercase\">PILLAR III \302\267 TORQUE</span>\n              <div className=\"p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--accent-cyan)] border border-[var(--border-color)]\">\n                <Zap className=\"w-5 h-5\" />\n              </div>\n            </div>\n            <h3 className=\"font-primary font-bold text-xl text-[var(--text-primary)] mb-2\">Synchronized Dyno</h3>\n            <p className=\"text-xs text-[var(--text-secondary)] leading-relaxed\">\n              Aero-ducted dynamometer chamber capable of logging 1,400 ECU telemetry channels with real-time lambda air-fuel optimization.\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
