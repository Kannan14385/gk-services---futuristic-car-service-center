        }
        lines {
          text: "      const elapsedTime = clock.getElapsedTime();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      underGlowLight.intensity = 2.2 + Math.sin(elapsedTime * 3) * 0.6;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Update HUD telemetry degrees"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const azimuthDeg = Math.round(((state.theta * 180) / Math.PI) % 360);"
